        </mxCell>
        <mxCell id="m1" value="2. GET /api/v1/tables/available?shift=..." style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0385;entryX=0;entryY=0.0;" edge="1" parent="1" source="act6" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
