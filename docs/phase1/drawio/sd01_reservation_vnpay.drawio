          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note21" value="[Còn bàn: Gán bàn mới | Hết bàn: Paid_TableLost + Báo CSKH]" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="550" y="1200" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m22" value="18b. Gán bàn mới (Reserved) HOẶC Lưu Paid_TableLost" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m23" value="19b. SignalR Push Notification cho CSKH (nếu TableLost)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0.9167;entryX=1;entryY=0.9231;" edge="1" parent="1" source="act5" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m24" value="20. RspCode: 00 (Confirm Success)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=1;exitY=1.0;entryX=0;entryY=0.9333;" edge="1" parent="1" source="act5" target="act7">
