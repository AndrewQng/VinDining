          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="12. Chuyển hướng sang VNPAY Gateway" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4231;entryX=0;entryY=0.0;" edge="1" parent="1" source="act6" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="13. Quét mã QR thanh toán tiền cọc" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4825;entryX=0;entryY=0.0667;" edge="1" parent="1" source="g" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="14. POST /api/v1/payments/vnpay-ipn (Server-to-Server)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.1333;entryX=1;entryY=0.0;" edge="1" parent="1" source="act7" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m14" value="15. Kiểm tra chữ ký Checksum &amp; Số tiền" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0833;entryX=1;entryY=0.1333;" edge="1" parent="1" source="act5" target="act5">
