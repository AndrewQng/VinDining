          </mxGeometry>
        </mxCell>
        <mxCell id="note15" value="[alt: IPN đúng hạn (&lt; 17 phút)]" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="550" y="880" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m16" value="16a. Cập nhật Reservation -&gt; Reserved, Table -&gt; Reserved" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3;entryX=0;entryY=0.6957;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m17" value="17a. Gửi Email &amp; SMS xác nhận kèm BookingCode" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0.3833;entryX=1;entryY=0.0;" edge="1" parent="1" source="act5" target="act8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
