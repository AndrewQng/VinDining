        <mxCell id="m0" value="1. Chọn ngày, ca, số khách, khu vực bàn" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0629;entryX=0;entryY=0.0;" edge="1" parent="1" source="g" target="act6">
