        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="cqrs">
          <mxGeometry x="45" y="440" width="10" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="api">
          <mxGeometry x="45" y="140" width="10" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="act5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="mobile">
          <mxGeometry x="45" y="90" width="10" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="1. Mở link từ Email/QR hóa đơn sau khi dùng bữa" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1023;entryX=0;entryY=0.0;" edge="1" parent="1" source="guest" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="2. GET /api/v1/feedback/context?bookingCode=..." style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="3. Kiểm tra mã đặt bàn &amp; Hóa đơn đã thanh toán" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0833;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="4. Thông tin bữa ăn hợp lệ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.1667;" edge="1" parent="1" source="act0" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="5. 200 OK (Render form đánh giá)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.25;entryX=1;entryY=0.2667;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="6. Chọn số sao (1-5), nhập nhận xét món &amp; dịch vụ" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3864;entryX=0;entryY=0.3333;" edge="1" parent="1" source="guest" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="7. POST /api/v1/feedback/submit" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4;entryX=0;entryY=0.4167;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="8. Send(SubmitFeedbackCommand)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="9. Lưu Feedback (Rating, Comment, BookingCode, Timestamp)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="10. SaveChangesAsync()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.4;" edge="1" parent="1" source="act1" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="11. Push NewFeedbackReceived event" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="12. Cập nhật chỉ số CSAT &amp; Thông báo đánh giá mới" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=1.0;entryX=0.5;entryY=0.7273;" edge="1" parent="1" source="act2" target="mgr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="13. FeedbackResponseDto" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.9167;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="14. 200 OK (Cảm ơn quý khách)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8667;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m14" value="15. Hiển thị thông điệp triân thực khách" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.9333;entryX=0.5;entryY=0.8977;" edge="1" parent="1" source="act5" target="guest">
