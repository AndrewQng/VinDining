          <mxGeometry height="120" width="290" x="830" y="390" as="geometry" />
        </mxCell>
        <mxCell id="st_cancelled" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" value="Cancelled (Hủy món)&#xa;---------------------------------------&#xa;entry / Hủy món (từ Queued hoặc Preparing)&#xa;do / Ghi nhận audit log lý do hủy&#xa;exit / Đóng trạng thái món hủy" vertex="1">
          <mxGeometry height="120" width="310" x="280" y="390" as="geometry" />
