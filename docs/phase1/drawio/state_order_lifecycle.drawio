        </mxCell>
        <mxCell id="st_queued" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0284c7;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" value="Queued (Chờ chế biến / Hold)&#xa;---------------------------------------&#xa;entry / Nhận đơn từ Waitstaff POS&#xa;do / Giữ lệnh (Hold) theo nhịp Course&#xa;exit / Kích hoạt nấu (Fire / Auto-Fire)" vertex="1">
          <mxGeometry height="140" width="270" x="120" y="180" as="geometry" />
        </mxCell>
        <mxCell id="st_preparing" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" value="Preparing (Đang chế biến)&#xa;---------------------------------------&#xa;entry / Phát SignalR tới KDS &amp;amp; TableDisplay&#xa;do / KDS đếm ngược SLA &amp;amp; Bếp nấu&#xa;exit / Đặt đĩa món hoàn tất ra quầy Pass" vertex="1">
          <mxGeometry height="140" width="280" x="470" y="180" as="geometry" />
