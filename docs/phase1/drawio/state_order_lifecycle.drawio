<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram name="State Machine Vòng đời Đơn hàng &amp; Món" id="state_order_lifecycle">
    <mxGraphModel dx="2020" dy="1201" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;fontColor=#333333;" value="SƠ ĐỒ MÁY TRẠNG THÁI VÒNG ĐỜI ĐƠN HÀNG &amp;amp; MÓN ĂN (ORDER &amp;amp; ITEM LIFECYCLE)" vertex="1">
          <mxGeometry height="40" width="950" x="150" y="110" as="geometry" />
        </mxCell>
