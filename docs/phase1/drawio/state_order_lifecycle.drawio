        <mxCell id="st_served" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" value="Served (Đã phục vụ tại bàn)&#xa;---------------------------------------&#xa;entry / Expediter kiểm QC &amp;amp; bấm Served (BR-04)&#xa;do / Waitstaff bưng ra bàn 2 tay (Zero-touch)&#xa;exit / Khách dùng xong đĩa món" vertex="1">
          <mxGeometry height="140" width="290" x="830" y="180" as="geometry" />
        </mxCell>
