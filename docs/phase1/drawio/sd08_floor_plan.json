{
  "title": "SD-08: Quản trị & Cấu hình Sơ đồ bàn ăn (Floor Plan Configuration)",
  "participants": [
    {
      "id": "mgr",
      "label": "Quản lý (Manager)",
      "actor": true
    },
    {
      "id": "fe",
      "label": "Manager Web Portal"
    },
    {
      "id": "ctrl",
      "label": "TableController"
    },
    {
      "id": "handler",
      "label": "UpdateFloorPlanCommandHandler"
    },
    {
      "id": "db",
      "label": "AppDbContext"
    },
    {
      "id": "hub",
      "label": "TableHub (SignalR)"
    },
    {
      "id": "staff",
      "label": "Waitstaff Tablet"
    }
  ],
  "messages": [
    {
      "from": "mgr",
      "to": "fe",
      "label": "1. Kéo thả định vị tọa độ (X, Y), phân khu & sức chứa bàn"
    },
    {
      "from": "mgr",
      "to": "fe",
      "label": "2. Bấm \"Lưu thay đổi Sơ đồ bàn\""
    },
    {
      "from": "fe",
      "to": "ctrl",
      "label": "3. PUT /api/admin/tables/layout (TableLayoutDto[])"
    },
    {
      "from": "ctrl",
      "to": "handler",
      "label": "4. Send(UpdateFloorPlanCommand)"
    },
    {
      "from": "handler",
      "to": "db",
      "label": "5. Query danh sách bàn hiện tại"
    },
    {
      "from": "db",
      "to": "handler",
      "label": "6. Trả về danh sách Table Entities",
      "return": true
    },
    {
      "from": "handler",
      "to": "handler",
      "label": "7. Kiểm tra trùng lặp mã bàn & trạng thái"
    },
    {
      "from": "handler",
      "to": "db",
      "label": "8. Cập nhật tọa độ (X, Y), Zone, Capacity & SaveChangesAsync()"
    },
    {
      "from": "db",
      "to": "handler",
      "label": "9. Commit Transaction thành công",
      "return": true
    },
    {
      "from": "handler",
      "to": "hub",
      "label": "10. Clients.All.SendAsync(\"FloorPlanUpdated\", layout)"
    },
    {
      "from": "hub",
      "to": "staff",
      "label": "11. Broadcast SignalR cập nhật sơ đồ bàn thời gian thực",
      "return": true
    },
    {
      "from": "handler",
      "to": "ctrl",
      "label": "12. Return Result.Success()",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "fe",
      "label": "13. 200 OK (LayoutUpdatedResponse)",
      "return": true
    },
    {
      "from": "fe",
      "to": "mgr",
      "label": "14. Hiển thị thông báo lưu thành công & cập nhật trực quan",
      "return": true
    }
  ]
}
