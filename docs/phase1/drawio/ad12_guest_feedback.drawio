        <mxCell id="g1_act3" value="Bấm &#39;Gửi đánh giá&#39;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane1">
          <mxGeometry x="65" y="390" width="210" height="55" as="geometry" />
