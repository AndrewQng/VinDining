        <mxCell id="g1_act1" value="Quét mã QR trên phiếu hóa đơn&#xa;hoặc mở link khảo sát qua Email" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane1">
