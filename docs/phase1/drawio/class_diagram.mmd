        E3["<b>&lt;&lt;Enum&gt;&gt;<br>ReservationStatus</b><hr>AwaitingPayment<br>Confirmed<br>Completed<br>Cancelled<br>Expired<br>Paid_TableLost"]
        E4["<b>&lt;&lt;Enum&gt;&gt;<br>OrderItemStatus</b><hr>Preparing<br>Served<br>Cancelled"]
