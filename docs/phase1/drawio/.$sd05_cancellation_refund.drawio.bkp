        <!-- Messages Flow -->
        <!-- 1. Bấm yêu cầu Hủy bàn -->
        <mxCell id="m0" edge="1" parent="1" source="g" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0800;entryX=0;entryY=0.0110;fontSize=14;" target="act_fe" value="1. Yêu cầu Hủy bàn (Nhập lý do)">
