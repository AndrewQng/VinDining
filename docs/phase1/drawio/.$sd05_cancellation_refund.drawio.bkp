        <mxCell id="m4" edge="1" parent="1" source="act_db1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.7500;entryX=1;entryY=0.1467;fontSize=14;" target="act_h" value="5. Trả về thông tin Reservation &amp; Deposit">
