  "messages": [
    {
      "from": "g",
      "to": "emenu",
      "label": "1. Xem ảnh, câu chuyện & cấu trúc Course (View-only)"
    },
    {
      "from": "g",
      "to": "w",
      "label": "2. Gọi nhân viên để đặt món & báo dị ứng"
    },
    {
      "from": "w",
      "to": "tab",
      "label": "3. Chọn bàn & Thêm các món ăn/SetMenu vào đơn"
    },
    {
      "from": "w",
      "to": "tab",
      "label": "4. Nhập ghi chú món ăn & dị ứng (SpecialNotes)"
    },
    {
      "from": "w",
      "to": "tab",
      "label": "5. Bấm nút 'Tạo đơn & Gửi Bếp'"
    },
    {
      "from": "tab",
      "to": "api",
      "label": "6. POST /api/orders"
    },
    {
      "from": "api",
      "to": "api",
      "label": "7. Lưu Order (Processing), Course 1 -> Preparing (SLA Timer), Course 2..N -> Queued"
    },
    {
      "from": "api",
      "to": "hub",
      "label": "8. Broadcast sự kiện OrderDispatchedToKds"
    },
    {
      "from": "hub",
      "to": "kds",
      "label": "9. Đẩy vé điện tử lên KDS Bếp (Hiển thị SLA & bôi đậm Dị ứng theo món)"
    },
    {
      "from": "api",
      "to": "hub",
      "label": "10. Broadcast sự kiện TableStatusUpdated"
    },
    {
      "from": "hub",
      "to": "disp",
      "label": "11. Cập nhật TableDisplay: 'Bếp đang chuẩn bị [Tên món]'"
    },
    {
      "from": "api",
      "to": "tab",
      "label": "12. 200 OK (Đã điều phối KDS Bếp thành công)",
      "return": true
    }
  ]
