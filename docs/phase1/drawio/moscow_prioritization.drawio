<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram name="MoSCoW Prioritization Chart" id="moscow_chart">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="BIỂU ĐỒ PHÂN BỔ MỨC ĐỘ ƯU TIÊN YÊU CẦU HỆ THỐNG (MOSCOW PRIORITIZATION MATRIX - VINDINING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="225" y="15" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Column 1: MUST HAVE -->
        <mxCell id="col_m" value="M - MUST HAVE (BẮT BUỘC CÓ — 60% NỖ LỰC)&#xa;Cốt lõi duy trì vận hành Fine Dining không thể thiếu" style="swimlane;startSize=50;fillColor=#fee2e2;strokeColor=#dc2626;fontStyle=1;rounded=1;fontSize=11;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="300" height="720" as="geometry" />
        </mxCell>
        <mxCell id="m_c1" value="REQ-01: Đặt bàn trực tuyến &amp; Cọc VNPAY&#xa;────────────────────────────────&#xa;• Chọn ngày, giờ, khu vực, bàn &amp; Set Menu&#xa;• Khóa giữ bàn tạm 17 phút (BR-01)&#xa;• Thanh toán cọc qua VNPAY (BR-06)&#xa;• Gửi mã đặt bàn qua SMS/Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_m">
          <mxGeometry x="15" y="65" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m_c2" value="REQ-02: Yêu cầu phục vụ qua QR-Menu&#xa;────────────────────────────────&#xa;• Quét QR tại bàn đã check-in&#xa;• Xem thực đơn trên điện thoại&#xa;• Gọi phục vụ, châm nước, đổi dụng cụ&#xa;• Phục vụ nhận thông báo &amp; xác nhận" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_m">
          <mxGeometry x="15" y="195" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m_c3" value="REQ-03: Check-in nhận bàn&#xa;────────────────────────────────&#xa;• Tra cứu mã đặt bàn hoặc số điện thoại&#xa;• Đối chiếu số khách &amp; dẫn vào bàn&#xa;• Check-in khách vãng lai&#xa;• Bàn chuyển Occupied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_m">
          <mxGeometry x="15" y="325" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m_c4" value="REQ-04: Waitstaff Order &amp; Expediter Pass&#xa;────────────────────────────────&#xa;• Phục vụ tạo Order trên điện thoại&#xa;• Gửi món vào bếp theo Course (BR-05)&#xa;• Expediter kiểm đĩa &amp; bấm Served (BR-03)&#xa;• Món không đạt: yêu cầu bếp làm lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_m">
          <mxGeometry x="15" y="455" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m_c5" value="REQ-05: Hóa đơn &amp; Cấn trừ tiền cọc&#xa;────────────────────────────────&#xa;• Tự động tính 5% Phí phục vụ, 10% VAT&#xa;• Tự động cấn trừ 100% tiền cọc (BR-02)&#xa;• Thu ngân xác nhận, bàn chuyển Cleaning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_m">
          <mxGeometry x="15" y="585" width="270" height="105" as="geometry" />
        </mxCell>

        <!-- Column 2: SHOULD HAVE -->
        <mxCell id="col_s" value="S - SHOULD HAVE (NÊN CÓ — 20% NỖ LỰC)&#xa;Tối ưu hóa vận hành và tự động hóa quản trị" style="swimlane;startSize=50;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;rounded=1;fontSize=11;fontColor=#92400e;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="300" height="720" as="geometry" />
        </mxCell>
        <mxCell id="s_c1" value="REQ-06: Quản trị Thực đơn động&#xa;────────────────────────────────&#xa;• Tùy biến danh mục món &amp; Course&#xa;• Thiết lập định mức Prep SLA&#xa;• Cập nhật đơn giá &amp; còn / tạm hết món&#xa;• Áp dụng ngay cho giao diện gọi món" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_s">
          <mxGeometry x="15" y="65" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="s_c2" value="REQ-07: Phân quyền nội bộ RBAC (JWT)&#xa;────────────────────────────────&#xa;• Xác thực bảo mật JWT Token&#xa;• 4 vai trò: Phục vụ, Điều phối,&#xa;  Thu ngân, Quản lý&#xa;• Bảo vệ Endpoint API qua Policies&#xa;• Khách hàng không cần đăng ký tài khoản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_s">
          <mxGeometry x="15" y="225" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s_c3" value="REQ-08: Duyệt hoàn cọc thủ công (Override)&#xa;────────────────────────────────&#xa;• Dành riêng cho Quản lý (BR-04)&#xa;• Xử lý ngoại lệ sự cố bất khả kháng&#xa;• Nhập lý do bắt buộc &amp; ghi Audit Log&#xa;• Kích hoạt API hoàn tiền VNPAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_s">
          <mxGeometry x="15" y="395" width="270" height="145" as="geometry" />
        </mxCell>

        <!-- Column 3: COULD HAVE -->
        <mxCell id="col_c" value="C - COULD HAVE (KHUYẾN KHÍCH — 15% NỖ LỰC)&#xa;Nâng cao trải nghiệm thực khách &amp; báo cáo" style="swimlane;startSize=50;fillColor=#eff6ff;strokeColor=#2563eb;fontStyle=1;rounded=1;fontSize=11;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="690" y="80" width="300" height="720" as="geometry" />
        </mxCell>
        <mxCell id="c_c1" value="REQ-09: Khách gửi Đánh giá dịch vụ&#xa;────────────────────────────────&#xa;• Quét QR trên phiếu hoặc mở link tin nhắn&#xa;• Đánh giá sao món ăn, không gian, phục vụ&#xa;• Nhập ý kiến đóng góp&#xa;• Tổng hợp vào báo cáo chất lượng dịch vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_c">
          <mxGeometry x="15" y="65" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c_c2" value="REQ-10: Dashboard Báo cáo Thống kê&#xa;────────────────────────────────&#xa;• Doanh thu theo ngày, tuần, tháng, quý&#xa;• Lượt khách, tỷ lệ lấp đầy &amp; hủy cọc&#xa;• Danh sách món ăn bán chạy nhất&#xa;• Xuất dữ liệu thống kê ra file Excel/PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_c">
          <mxGeometry x="15" y="245" width="270" height="145" as="geometry" />
        </mxCell>

        <!-- Column 4: WON'T HAVE -->
        <mxCell id="col_w" value="W - WON'T HAVE (KHÔNG PHÁT TRIỂN — 5%)&#xa;Nằm ngoài định vị trải nghiệm Fine Dining" style="swimlane;startSize=50;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;rounded=1;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="300" height="720" as="geometry" />
        </mxCell>
        <mxCell id="w_c1" value="REQ-11: Giao hàng tận nơi (Delivery)&#xa;────────────────────────────────&#xa;• Đặt món ăn mang về nhà&#xa;• Tính phí vận chuyển theo cự ly GPS&#xa;• Lý do loại bỏ: Không phù hợp với chuẩn mực&#xa;  nhiệt độ &amp; nghệ thuật bài trí của Fine Dining" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_w">
          <mxGeometry x="15" y="65" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="w_c2" value="REQ-12: Tích hợp App bên thứ 3&#xa;────────────────────────────────&#xa;• Tích hợp GrabFood, ShopeeFood, Baemin&#xa;• Chiết khấu cao (20–30%) gây thất thoát&#xa;• Định vị thương hiệu nhà hàng độc lập&#xa;• 100% tập trung vào In-House Dining" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;align=left;spacing=8;fontSize=11;" vertex="1" parent="col_w">
          <mxGeometry x="15" y="245" width="270" height="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>