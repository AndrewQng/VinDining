      "from": "tab",
      "to": "ctrl",
      "label": "4. PATCH /api/orders/{orderId}/items/{itemId}/serve"
    },
    {
      "from": "ctrl",
      "to": "handler",
      "label": "5. Send(ConfirmServingCommand)"
    },
    {
      "from": "handler",
      "to": "db",
      "label": "6. Query OrderItem"
    },
    {
      "from": "db",
      "to": "handler",
