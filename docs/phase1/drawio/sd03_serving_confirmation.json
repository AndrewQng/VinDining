      "return": true
    },
    {
      "from": "handler",
      "to": "db",
      "label": "8. Update(Status = Served, ServedAt = UtcNow) & SaveChangesAsync()"
    },
    {
      "from": "db",
      "to": "handler",
      "label": "9. Xác nhận thành công",
      "return": true
    },
    {
      "from": "handler",
      "to": "w",
      "label": "10. SignalR: Báo món sẵn sàng (tableId, dishName)"
    },
    {
      "from": "handler",
      "to": "ctrl",
      "label": "11. ServingConfirmedResponseDto",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "tab",
      "label": "12. 200 OK",
      "return": true
    },
    {
      "from": "tab",
      "to": "exp",
      "label": "13. Hiển thị xác nhận ra món thành công",
      "return": true
    },
    {
      "from": "exp",
      "to": "w",
      "label": "14. Đưa món cho Waitstaff"
    },
    {
      "from": "w",
      "to": "w",
