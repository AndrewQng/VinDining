        <mxCell id="w_act4" value="Đến quầy Pass lấy đĩa món&#xa;&amp; bưng ra bàn cho thực khách" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_staff">
          <mxGeometry x="75" y="750" width="210" height="55" as="geometry"/>
        </mxCell>

        <!-- Lane 3 (Kitchen) -->
        <mxCell id="k_act1" value="Kẹp phiếu order giấy lên thanh ray,&#xa;đọc chữ viết tay &amp; điều phối nấu" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_kitchen">
          <mxGeometry x="65" y="300" width="220" height="55" as="geometry"/>
