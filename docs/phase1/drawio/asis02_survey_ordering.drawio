  <diagram name="As-Is 02 Gọi món &amp; Điều phối Bếp truyền thống" id="asis02_survey_ordering">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Swimlanes -->
        <mxCell id="lane_guest" value="Khách hàng (Guest)" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f8f9fa;strokeColor=#333333;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="320" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane_staff" value="Nhân viên Phục vụ (Waitstaff)" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f8f9fa;strokeColor=#333333;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="360" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane_kitchen" value="Nhà bếp &amp; Bếp trưởng (Kitchen/Chef)" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f8f9fa;strokeColor=#333333;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="40" width="340" height="900" as="geometry"/>
        </mxCell>

        <!-- Lane 1 (Guest) -->
        <mxCell id="g_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e53935;strokeColor=#b71c1c;" vertex="1" parent="lane_guest">
          <mxGeometry x="145" y="60" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g_act1" value="Xem Menu giấy bìa da truyền thống&#xa;&amp; gọi Phục vụ lại bàn" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_guest">
          <mxGeometry x="55" y="120" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_act2" value="Đọc tên món, set Tasting Menu&#xa;&amp; dặn dò dị ứng bằng miệng" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_guest">
          <mxGeometry x="55" y="210" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_act3" value="Khách nhận món ăn tại bàn&#xa;&amp; bắt đầu thưởng thức" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_guest">
          <mxGeometry x="55" y="750" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_end_succ" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="lane_guest">
          <mxGeometry x="145" y="835" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g_end_succ_dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2e7d32;strokeColor=none;" vertex="1" parent="lane_guest">
          <mxGeometry x="151" y="841" width="18" height="18" as="geometry"/>
        </mxCell>

        <!-- Lane 2 (Waitstaff) -->
        <mxCell id="w_act1" value="Dùng bút bi ghi chép món ăn &amp;&#xa;ghi chú dị ứng vào Order Pad giấy" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_staff">
          <mxGeometry x="75" y="210" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="w_act2" value="Di chuyển bộ xuống quầy Bếp&#xa;để gửi tờ phiếu order giấy" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_staff">
          <mxGeometry x="75" y="300" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="w_act3" value="Đang bận phục vụ bàn khác,&#xa;không nghe thấy tiếng chuông quầy Pass" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#757575;strokeColor=#424242;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_staff">
          <mxGeometry x="75" y="570" width="210" height="55" as="geometry"/>
