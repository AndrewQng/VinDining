        <mxCell id="k_act2" value="Đầu bếp chế biến món theo Course&#xa;(Khai vị, Món chính, Tráng miệng)" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_kitchen">
          <mxGeometry x="65" y="390" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="k_act3" value="Nấu xong, đặt món ra quầy Pass,&#xa;gọi miệng hoặc bấm chuông cơ học" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#5b40ff;strokeColor=#4527a0;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_kitchen">
          <mxGeometry x="65" y="480" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="k_dec1" value="Phục vụ có mặt&#xa;ngay lập tức?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#880e4f;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="lane_kitchen">
          <mxGeometry x="115" y="570" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="k_act_wait" value="Món nằm chờ tại quầy Pass&#xa;(Nguội lạnh &amp; giảm chất lượng)" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#c00000;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="lane_kitchen">
          <mxGeometry x="65" y="660" width="220" height="55" as="geometry"/>
        </mxCell>

        <!-- Pain Point Callouts -->
        <mxCell id="callout1" value="⚠️ NGUY CƠ TỬ VONG / DỊ ỨNG:&#xa;Chữ viết tay vội dễ sót lưu ý&#xa;dị ứng nghiêm trọng của khách" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#c00000;fontSize=10;fontStyle=1;size=12;" vertex="1" parent="lane_staff">
          <mxGeometry x="180" y="130" width="160" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="callout2" value="⚠️ ĐIỂM NGHẼN VẬN HÀNH:&#xa;Truyền tin thủ công làm đĩa món&#xa;bị nguội lạnh 3-5 phút ở Pass" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#b45f06;fontSize=10;fontStyle=1;size=12;" vertex="1" parent="lane_kitchen">
          <mxGeometry x="65" y="825" width="220" height="55" as="geometry"/>
