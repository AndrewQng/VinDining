          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="12. SendToDevice(DeviceId, 'DeviceActivated', { TableId })" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
