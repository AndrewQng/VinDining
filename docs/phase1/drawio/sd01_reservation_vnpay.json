{
  "title": "SD-01: Đặt bàn trực tuyến & Thanh toán cọc VNPAY",
  "participants": [
    {
      "id": "g",
      "label": "Khách hàng (Guest)",
      "actor": true
    },
    {
      "id": "fe",
      "label": "Web Frontend (React)"
    },
    {
      "id": "api",
      "label": "Web API (.NET 9)"
    },
    {
      "id": "db",
      "label": "SQL Server & Cache"
    },
    {
      "id": "vn",
      "label": "Cổng VNPAY"
    }
  ],
  "messages": [
    {
      "from": "g",
      "to": "fe",
      "label": "1. Chọn ngày, ca, số khách, khu vực bàn"
    },
    {
      "from": "fe",
      "to": "api",
      "label": "2. GET /api/v1/tables/available?shift=..."
    },
    {
      "from": "api",
      "to": "db",
      "label": "3. Query bàn trống khả dụng"
    },
    {
      "from": "db",
      "to": "api",
      "label": "4. Trả về trạng thái bàn",
      "return": true
    },
    {
      "from": "api",
      "to": "fe",
      "label": "5. 200 OK (Danh sách bàn)",
      "return": true
    },
    {
      "from": "g",
      "to": "fe",
      "label": "6. Nhập thông tin cá nhân & Bấm Đặt cọc"
    },
    {
      "from": "fe",
      "to": "api",
      "label": "7. POST /api/v1/reservations/create-hold"
    },
    {
      "from": "api",
      "to": "db",
      "label": "8. Khóa giữ bàn 17 phút (Expire: 17p - BR-01)"
    },
    {
      "from": "api",
      "to": "vn",
      "label": "9. CreatePaymentUrl(DepositAmount)"
    },
    {
      "from": "vn",
      "to": "api",
      "label": "10. Trả về PaymentUrl",
      "return": true
    },
    {
      "from": "api",
      "to": "fe",
      "label": "11. 200 OK (PaymentUrl)",
      "return": true
    },
    {
      "from": "fe",
      "to": "vn",
      "label": "12. Chuyển hướng sang VNPAY Gateway"
    },
    {
      "from": "g",
      "to": "vn",
      "label": "13. Quét mã QR thanh toán tiền cọc"
    },
    {
      "from": "vn",
      "to": "api",
      "label": "14. POST /api/v1/payments/vnpay-ipn (Server-to-Server)"
    },
    {
      "from": "api",
      "to": "api",
      "label": "15. Kiểm tra chữ ký Checksum & Số tiền"
    },
    {
      "note": "[alt: IPN đúng hạn (< 17 phút)]",
      "over": "api"
    },
    {
      "from": "api",
      "to": "db",
      "label": "16a. Cập nhật Reservation -> Reserved, Table -> Reserved"
    },
    {
      "from": "api",
      "to": "g",
      "label": "17a. Gửi Email & SMS xác nhận kèm BookingCode",
      "async": true
    },
    {
      "note": "[else: IPN trễ (> 17 phút) & Bàn đã mất]",
      "over": "api"
    },
    {
      "from": "api",
      "to": "db",
      "label": "16b. Quét tìm bàn trống tương đương (Auto-Reallocate)"
    },
    {
      "from": "db",
      "to": "api",
      "label": "17b. Trả kết quả tìm bàn tương đương",
      "return": true
    },
    {
      "note": "[Còn bàn: Gán bàn mới | Hết bàn: Paid_TableLost + Báo CSKH]",
      "over": "api"
    },
    {
      "from": "api",
      "to": "db",
      "label": "18b. Gán bàn mới (Reserved) HOẶC Lưu Paid_TableLost"
    },
    {
      "from": "api",
      "to": "fe",
      "label": "19b. SignalR Push Notification cho CSKH (nếu TableLost)",
      "async": true
    },
    {
      "from": "api",
      "to": "vn",
      "label": "20. RspCode: 00 (Confirm Success)",
      "return": true
    }
  ]
}
