{
  "title": "SD-01: Đặt bàn trực tuyến & Thanh toán cọc VNPAY",
  "participants": [
    {
      "id": "g",
      "label": "Khách hàng (Guest)",
      "actor": true
    },
    {
      "id": "fe",
      "label": "Web Frontend (React)"
    },
    {
      "id": "api",
      "label": "Web API (.NET 9)"
    },
    {
      "id": "db",
      "label": "SQL Server & Cache"
    },
    {
      "id": "vn",
      "label": "Cổng VNPAY"
    }
  ],
  "messages": [
    {
      "from": "g",
      "to": "fe",
      "label": "1. Chọn ngày, ca, số khách, khu vực bàn"
    },
    {
      "from": "fe",
      "to": "api",
      "label": "2. GET /api/tables/layout"
    },
    {
      "from": "api",
      "to": "db",
      "label": "3. Query bàn trống khả dụng"
    },
    {
      "from": "db",
      "to": "api",
      "label": "4. Trả về trạng thái bàn",
      "return": true
    },
    {
      "from": "api",
      "to": "fe",
      "label": "5. 200 OK (Danh sách bàn)",
      "return": true
    },
    {
      "from": "g",
      "to": "fe",
      "label": "6. Nhập thông tin cá nhân & Bấm Đặt cọc"
    },
    {
      "from": "fe",
      "to": "api",
      "label": "7. POST /api/reservations/hold"
    },
    {
      "from": "api",
      "to": "db",
      "label": "8. Khóa giữ bàn 17 phút (Expire: 17p - BR-01)"
    },
    {
      "from": "api",
      "to": "vn",
      "label": "9. CreatePaymentUrl(DepositAmount)"
    },
    {
      "from": "vn",
      "to": "api",
      "label": "10. Trả về PaymentUrl",
      "return": true
    },
    {
      "from": "api",
      "to": "fe",
      "label": "11. 200 OK (PaymentUrl)",
      "return": true
    },
    {
      "from": "fe",
      "to": "vn",
      "label": "12. Chuyển hướng sang VNPAY Gateway"
    },
    {
      "from": "g",
      "to": "vn",
      "label": "13. Quét mã QR thanh toán tiền cọc"
    },
    {
      "from": "vn",
      "to": "api",
      "label": "14. POST /api/payments/vnpay-ipn (Server-to-Server)"
    },
    {
      "from": "api",
      "to": "api",
      "label": "15. Kiểm tra chữ ký Checksum & Số tiền"
    },
    {
      "note": "[alt: IPN đúng hạn (< 17 phút)]",
      "over": "api"
    },
    {
      "from": "api",
      "to": "db",
      "label": "16a. Cập nhật Reservation -> Reserved, Table -> Reserved"
    },
    {
      "from": "api",
      "to": "g",
      "label": "17a. Gửi Email & SMS xác nhận kèm BookingCode",
      "async": true
    },
    {
      "note": "[else: IPN trễ (> 17 phút) & Bàn cũ đã giải phóng / mất lượt]",
      "over": "api"
    },
    {
      "from": "api",
      "to": "vn",
      "label": "16b. POST /refund (Gọi VNPAY Refund API hoàn 100% cọc tự động)"
    },
    {
      "from": "vn",
      "to": "api",
      "label": "17b. Refund Success (Mã giao dịch hoàn tiền)",
      "return": true
    },
    {
      "from": "api",
      "to": "db",
      "label": "18b. Cập nhật Reservation = Expired_AutoRefunded & Deposit = Refunded"
    },
    {
      "from": "api",
      "to": "g",
      "label": "19b. Gửi Email & SMS xin lỗi quá hạn & xác nhận hoàn cọc 100%",
      "async": true
    },
    {
      "from": "api",
      "to": "vn",
      "label": "20. RspCode: 00 (Confirm Success)",
      "return": true
    }
  ]
}
