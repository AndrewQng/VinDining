{
  "title": "SD-09: Quản lý duyệt hoàn cọc thủ công ngoại lệ (UC-A3 / BR-05)",
  "participants": [
    {
      "id": "guest",
      "label": "Khách hàng (Guest)",
      "actor": true
    },
    {
      "id": "mgr",
      "label": "Quản lý (Manager)",
      "actor": true
    },
    {
      "id": "fe",
      "label": "Manager Web Portal"
    },
    {
      "id": "ctrl",
      "label": "ReservationController"
    },
    {
      "id": "handler",
      "label": "ManualRefundCommandHandler"
    },
    {
      "id": "vnpay",
      "label": "VnPayService"
    },
    {
      "id": "db",
      "label": "AppDbContext"
    },
    {
      "id": "mail",
      "label": "EmailService"
    }
  ],
  "messages": [
    {
      "from": "guest",
      "to": "mgr",
      "label": "1. Phản ánh sự cố bất khả kháng xin hoàn cọc"
    },
    {
      "from": "mgr",
      "to": "fe",
      "label": "2. Tra cứu BookingCode, chọn \"Hoàn cọc ngoại lệ\""
    },
    {
      "from": "mgr",
      "to": "fe",
      "label": "3. Nhập lý do giải trình bắt buộc (Audit Reason)"
    },
    {
      "from": "fe",
      "to": "ctrl",
      "label": "4. POST /api/admin/reservations/{id}/manual-refund"
    },
    {
      "from": "ctrl",
      "to": "handler",
      "label": "5. Send(ManualRefundCommand)"
    },
    {
      "from": "handler",
      "to": "db",
      "label": "6. Query Reservation, Deposit & kiểm tra quyền Manager"
    },
    {
      "from": "db",
      "to": "handler",
      "label": "7. Trả về thông tin hợp lệ (Deposit = Paid)",
      "return": true
    },
    {
      "from": "handler",
      "to": "vnpay",
      "label": "8. RefundDeposit(txnRef, amount, reason)"
    },
    {
      "from": "vnpay",
      "to": "handler",
      "label": "9. RefundResult (Success, RspCode = 00)",
      "return": true
    },
    {
      "from": "handler",
      "to": "db",
      "label": "10. Set Deposit = Refunded, ghi AuditLog & SaveChangesAsync()"
    },
    {
      "from": "db",
      "to": "handler",
      "label": "11. Commit Transaction thành công",
      "return": true
    },
    {
      "from": "handler",
      "to": "mail",
      "label": "12. SendRefundConfirmationEmail(guestEmail, amount)"
    },
    {
      "from": "mail",
      "to": "guest",
      "label": "13. Gửi Email thông báo tiền hoàn về tài khoản",
      "return": true
    },
    {
      "from": "handler",
      "to": "ctrl",
      "label": "14. RefundSuccessResponse",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "fe",
      "label": "15. 200 OK (Hoàn tiền ngoại lệ thành công)",
      "return": true
    },
    {
      "from": "fe",
      "to": "mgr",
      "label": "16. Cập nhật trạng thái: Đã hoàn cọc ngoại lệ",
      "return": true
    }
  ]
}