{
  "title": "SD-10: Quét giải phóng bàn quá 17p & Tự động hoàn cọc Late IPN (UC-S1 / BR-01)",
  "participants": [
    {
      "id": "vn",
      "label": "Cổng VNPAY (Late IPN / Refund)"
    },
    {
      "id": "api",
      "label": "Web API (IPN Controller)"
    },
    {
      "id": "worker",
      "label": "Background Worker (Hangfire)"
    },
    {
      "id": "db",
      "label": "SQL Server (EF Core 9)"
    },
    {
      "id": "hub",
      "label": "SignalR Hub"
    },
    {
      "id": "staff",
      "label": "Nhân viên & Sơ đồ bàn"
    },
    {
      "id": "guest",
      "label": "Khách hàng (Guest)",
      "actor": true
    }
  ],
  "messages": [
    {
      "from": "worker",
      "to": "db",
      "label": "1. Query Reservation (PendingPayment & CreatedAt > 17m)"
    },
    {
      "from": "db",
      "to": "worker",
      "label": "2. Danh sách đơn quá hạn 17 phút (BR-01)",
      "return": true
    },
    {
      "from": "worker",
      "to": "db",
      "label": "3. Update Reservation = Expired_Cancelled"
    },
    {
      "from": "worker",
      "to": "db",
      "label": "4. Update Table = Available (Giải phóng bàn)"
    },
    {
      "from": "db",
      "to": "worker",
      "label": "5. SaveChangesAsync()",
      "return": true
    },
    {
      "from": "worker",
      "to": "hub",
      "label": "6. Broadcast TableStatusChanged (TableId, Available)"
    },
    {
      "from": "hub",
      "to": "staff",
      "label": "7. Sơ đồ bàn đổi màu Xanh (Available) tức thời",
      "async": true,
      "activate": false,
      "deactivate": true
    },
    {
      "from": "vn",
      "to": "api",
      "label": "8. Late IPN Callback: Giao dịch thành công (> 17 phút)"
    },
    {
      "from": "api",
      "to": "db",
      "label": "9. Kiểm tra: Đơn đã Expired & Bàn cũ đã giải phóng / có khách đặt?"
    },
    {
      "from": "db",
      "to": "api",
      "label": "10. Xác nhận: Bàn cũ đã giải phóng / đã đặt lại (Hết chỗ)",
      "return": true
    },
    {
      "from": "api",
      "to": "vn",
      "label": "11. POST /refund (Gọi VNPAY Refund API hoàn 100% cọc tự động)"
    },
    {
      "from": "vn",
      "to": "api",
      "label": "12. Refund Success (Mã giao dịch hoàn tiền thành công)",
      "return": true
    },
    {
      "from": "api",
      "to": "db",
      "label": "13. Update Reservation = Expired_AutoRefunded & Deposit = Refunded"
    },
    {
      "from": "db",
      "to": "api",
      "label": "14. SaveChangesAsync() thành công",
      "return": true
    },
    {
      "from": "api",
      "to": "guest",
      "label": "15. Tự động gửi SMS/Email xin lỗi quá hạn & xác nhận hoàn cọc 100%",
      "async": true,
      "activate": false,
      "deactivate": true
    },
    {
      "from": "api",
      "to": "vn",
      "label": "16. Trả về RspCode: 00 (Ghi nhận IPN hoàn tất)",
      "return": true
    }
  ]
}