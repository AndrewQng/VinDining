        <mxCell id="m0" value="1. Bấm yêu cầu Hủy bàn (Nhập lý do)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0978;entryX=0;entryY=0.0;" edge="1" parent="1" source="g" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="2. POST /api/reservations/{id}/cancel (hoặc manual-refund)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0943;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
