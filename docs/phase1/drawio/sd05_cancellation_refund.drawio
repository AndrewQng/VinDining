        <mxCell id="m0" value="1. Bấm yêu cầu Hủy bàn (Nhập lý do)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1286;entryX=0;entryY=0.0;" edge="1" parent="1" source="g" target="act4">
