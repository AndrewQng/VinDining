        <mxCell id="c_router_gw" value="WAN Cáp quang&#xa;HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="net_router" target="srv_gateway" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. Router to Printers (LAN Ethernet VLAN 3) -->
        <mxCell id="c_r_prn_hot" value="Ethernet&#xa;VLAN 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ea580c;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="net_router" target="prn_hot" parent="1">
          <mxGeometry relative="1" as="geometry" />
