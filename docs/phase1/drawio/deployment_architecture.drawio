        <!-- 10. API to VNPAY -->
        <mxCell id="c_api_vnpay" value="HTTPS API &amp; IPN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#c026d3;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" source="srv_api" target="ext_vnpay" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 11. API to Email -->
        <mxCell id="c_api_mail" value="SMTP (Port 587)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#c026d3;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" source="srv_api" target="ext_mail" parent="1">
