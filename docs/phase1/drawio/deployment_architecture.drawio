        <mxCell id="c_prn_bar" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ea580c;strokeWidth=1.5;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="prn_cold" target="prn_bar" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. Gateway to API -->
        <mxCell id="c_gw_api" value="Reverse Proxy&#xa;(Port 5000)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="srv_gateway" target="srv_api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. API to Printers (ESC/POS Socket 9100) -->
        <mxCell id="c_api_prn" value="ESC/POS&#xa;Port 9100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ea580c;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.4;entryX=1;entryY=0.5;" edge="1" source="srv_api" target="prn_hot" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. API to Database (Routed in the 60px corridor between box_lan and box_server at x=660) -->
