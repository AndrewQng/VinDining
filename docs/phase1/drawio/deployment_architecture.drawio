          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. API to Cache -->
        <mxCell id="c_api_cache" value="State Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=1;entryY=0.5;" edge="1" source="srv_api" target="srv_cache" parent="1">
          <mxGeometry relative="1" as="geometry">
