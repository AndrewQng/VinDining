<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram name="Khảo sát Nhu cầu Bên liên quan" id="stakeholder_needs">
    <mxGraphModel dx="2828" dy="1682" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=18;fontColor=#0f172a;" value="MÔ HÌNH NHU CẦU CÁC BÊN LIÊN QUAN (STAKEHOLDER VALUE &amp;amp; NEEDS MODEL - VINDINING)" vertex="1">
          <mxGeometry height="45" width="1000" x="360" y="50" as="geometry" />
        </mxCell>
        <mxCell id="hub_sys" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;spacing=10;" value="HỆ THỐNG VINDINING&lt;br&gt;(Core Restaurant Platform)&lt;br&gt;──────────────────────────────────────&lt;br&gt;• ASP.NET Core (.NET 9) Web API — MVC + REST (ADR 0005)&lt;br&gt;• SignalR Hubs: sơ đồ bàn, KDS Bếp &amp;amp; quầy Pass&lt;br&gt;• Cổng thanh toán cọc tự động VNPAY&lt;br&gt;• Điều phối món theo Course (BR-05)&lt;br&gt;• QR E-Menu &amp;amp; yêu cầu phục vụ tại bàn&lt;br&gt;• Tự động cấn trừ tiền cọc vào hóa đơn (BR-02)" vertex="1">
          <mxGeometry height="320" width="470" x="600" y="320" as="geometry" />
        </mxCell>
        <mxCell id="card_guest" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="THỰC KHÁCH (GUEST)&lt;br&gt;[Kênh: Mobile Web &amp;amp; QR E-Menu trên điện thoại]&lt;br&gt;──────────────────────────────────────&lt;br&gt;• Đặt bàn, chọn khu vực, bàn &amp;amp; Set Menu (tùy chọn)&lt;br&gt;• Đặt cọc an toàn qua VNPAY (giữ bàn 17 phút)&lt;br&gt;• Quét QR tại bàn xem thực đơn &amp;amp; gửi yêu cầu phục vụ&lt;br&gt;• Nhận hoàn cọc 100% tự động khi hủy trước ≥ 4 tiếng" vertex="1">
          <mxGeometry height="180" width="550" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="card_expediter" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#6b21a8;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="ĐIỀU PHỐI VIÊN (EXPEDITER)&#xa;[Kênh: Tablet cố định tại quầy Pass]&#xa;──────────────────────────────────────&#xa;• Nhận đĩa món chế biến hoàn tất từ Bếp tại quầy Pass&#xa;• Kiểm tra đĩa món, yêu cầu bếp làm lại nếu không đạt&#xa;• Thẩm quyền bấm &#x27;Xác nhận đi món&#x27; (Served) (BR-03)&#xa;• Báo món sẵn sàng tới thiết bị Phục vụ (SignalR)&#xa;• Bàn giao đĩa món cho Waitstaff mang ra bàn" vertex="1">
          <mxGeometry height="220" width="520" x="20" y="365" as="geometry" />
        </mxCell>
        <mxCell id="card_kitchen" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="MÀN HÌNH KDS BẾP (KITCHEN DISPLAY SYSTEM)&#xa;[Kênh: SignalR WebSockets (Hands-free / View-only)]&#xa;──────────────────────────────────────&#xa;• Tiếp nhận vé điện tử qua SignalR theo từng Course&#xa;• Hiển thị ghi chú món của phục vụ&#xa;• Đếm ngược Prep SLA, cảnh báo ở 80% (UC-S4, BR-05)&#xa;• Vận hành rảnh tay (Hands-free) chống bẩn dầu mỡ&#xa;• Ra món đúng tiêu chuẩn và chuyển quầy Pass" vertex="1">
          <mxGeometry height="260" width="510" x="70" y="620" as="geometry" />
        </mxCell>
        <mxCell id="card_staff" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="NHÂN VIÊN PHỤC VỤ (WAITSTAFF)&#xa;[Kênh: Điện thoại cầm tay tại phòng ăn]&#xa;──────────────────────────────────────&#xa;• Theo dõi sơ đồ bàn trực quan theo thời gian thực (SignalR)&#xa;• Check-in khách vào bàn (Occupied)&#xa;• Tư vấn gọi món &amp;amp; tạo Order theo Course (BR-05)&#xa;• Nhận món từ Pass, phục vụ khách tại bàn&#xa;• Gửi yêu cầu tính tiền về quầy Thu ngân (UC-E4)" vertex="1">
          <mxGeometry height="340" width="480" x="1120" y="130" as="geometry" />
        </mxCell><mxCell id="card_cashier" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#92400e;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="NHÂN VIÊN THU NGÂN (CASHIER)&#xa;[Kênh: Web POS tại quầy]&#xa;──────────────────────────────────────&#xa;• Nhận chuông báo bàn yêu cầu tính tiền (UC-E4)&#xa;• Xem tạm tính: 5% phí, 10% VAT, cấn trừ cọc (BR-02)&#xa;• In phiếu tạm tính kèm mã VietQR&#xa;• Xác nhận thanh toán (VietQR, tiền mặt, thẻ) &amp; đóng bàn" vertex="1">
          <mxGeometry height="220" width="480" x="600" y="920" as="geometry" />
        </mxCell><mxCell id="e_c_hub" edge="1" parent="1" source="card_cashier" style="exitX=0.5;exitY=0;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d97706;strokeWidth=2;html=1;fontSize=18;fontColor=#92400e;fontStyle=1;labelBackgroundColor=#ffffff;exitDx=0;exitDy=0;exitPerimeter=0;" target="hub_sys" value="Tạm tính, in phiếu&#xa;&amp; xác nhận thanh toán">
          <mxGeometry x="-0.55" relative="1" as="geometry">
            <mxPoint as="offset" />
            
          </mxGeometry>
        </mxCell>
        <mxCell id="card_mgr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#166534;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="QUẢN LÝ (MANAGER)&#xa;[Kênh: Web Portal Quản trị trên Desktop]&#xa;──────────────────────────────────────&#xa;• Giảm tổn thất bùng bàn nhờ chính sách đặt cọc VNPAY&#xa;• Xem doanh thu, lượt khách và tỷ lệ lấp đầy bàn ăn&#xa;• Quản trị thực đơn, giá món &amp;amp; cấu hình sơ đồ bàn ăn&#xa;• Duyệt hoàn cọc thủ công trong tình huống bất khả kháng&#xa;• Quản lý tài khoản &amp;amp; phân quyền RBAC" vertex="1">
          <mxGeometry height="300" width="550" x="1090" y="540" as="geometry" />
        </mxCell>
