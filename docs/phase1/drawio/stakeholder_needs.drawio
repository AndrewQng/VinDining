<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram name="Khảo sát Nhu cầu Bên liên quan" id="stakeholder_needs">
    <mxGraphModel dx="2828" dy="1682" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=18;fontColor=#0f172a;" value="MÔ HÌNH NHU CẦU CÁC BÊN LIÊN QUAN (STAKEHOLDER VALUE &amp;amp; NEEDS MODEL - VINDINING)" vertex="1">
          <mxGeometry height="45" width="1000" x="360" y="50" as="geometry" />
        </mxCell>
        <mxCell id="hub_sys" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;spacing=10;" value="HỆ THỐNG VINDINING&lt;br&gt;(Core Restaurant Platform)&lt;br&gt;──────────────────────────────────────&lt;br&gt;• ASP.NET Core (.NET 9) Web API &amp;amp; MediatR CQRS&lt;br&gt;• Real-time Floor &amp;amp; Kitchen Hubs (SignalR)&lt;br&gt;• Cổng thanh toán cọc tự động VNPAY&lt;br&gt;• Module điều phối KDS Bếp qua SignalR Hub&lt;br&gt;• Hệ thống EMenuTablet &amp;amp; TableDisplay tại bàn&amp;nbsp;&lt;br&gt;• Tự động cấn trừ tiền cọc vào hóa đơn&amp;nbsp;" vertex="1">
          <mxGeometry height="320" width="470" x="600" y="320" as="geometry" />
        </mxCell>
        <mxCell id="card_guest" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="THỰC KHÁCH (GUEST)&lt;br&gt;[Kênh: Mobile Web / EMenuTablet &amp;amp; TableDisplay]&lt;br&gt;──────────────────────────────────────&lt;br&gt;• Đặt bàn trực tuyến &amp;amp; chọn trước vị trí mong muốn&lt;br&gt;• Đặt cọc an toàn qua VNPAY (giữ bàn 17 phút)&lt;br&gt;• Khám phá món qua EMenuTablet &amp;amp; theo dõi qua TableDisplay&lt;br&gt;• Nhận hoàn cọc 100% tự động khi hủy trước &amp;gt;= 4h&amp;nbsp;" vertex="1">
          <mxGeometry height="180" width="550" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="card_expediter" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#6b21a8;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="ĐIỀU PHỐI VIÊN (EXPEDITER)&#xa;[Kênh: Tablet cố định tại quầy Pass]&#xa;──────────────────────────────────────&#xa;• Nhận đĩa món chế biến hoàn tất từ Bếp tại quầy Pass&#xa;• Kiểm tra QC đĩa món &amp;amp; đối chiếu dị ứng món ăn&#xa;• Thẩm quyền chạm nút 'Xác nhận ra món' (Served) (BR-04)&#xa;• Bắn SignalR tới TableDisplay và thiết bị Waitstaff&#xa;• Bàn giao đĩa món cho Waitstaff dọn ra bàn cho khách" vertex="1">
          <mxGeometry height="220" width="520" x="20" y="365" as="geometry" />
        </mxCell>
        <mxCell id="card_kitchen" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="MÀN HÌNH KDS BẾP (KITCHEN DISPLAY SYSTEM)&#xa;[Kênh: SignalR WebSockets (Hands-free / View-only)]&#xa;──────────────────────────────────────&#xa;• Tiếp nhận vé điện tử điều phối qua SignalR trạm Bếp/Bar&#xa;• Bôi đậm cảnh báo dị ứng &amp;amp; ghi chú món (SpecialNotes)&#xa;• Đếm ngược SLA chuẩn bị và xếp hàng đợi Course (BR-06)&#xa;• Vận hành rảnh tay (Hands-free) chống bẩn dầu mỡ&#xa;• Ra món đúng tiêu chuẩn ẩm thực cao cấp và chuyển Pass" vertex="1">
          <mxGeometry height="260" width="510" x="70" y="620" as="geometry" />
        </mxCell>
        <mxCell id="card_staff" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="NHÂN VIÊN PHỤC VỤ (WAITSTAFF)&#xa;[Kênh: Tablet POS cầm tay tại phòng ăn]&#xa;──────────────────────────────────────&#xa;• Theo dõi sơ đồ bàn trực quan theo thời gian thực (SignalR)&#xa;• Check-in khách vào bàn (Occupied) &amp;amp; kích hoạt phiên dùng bữa&#xa;• Tư vấn gọi món &amp;amp; tạo Order điều phối KDS qua SignalR&#xa;• Nhận món từ Pass, bưng phục vụ khách bằng 2 tay (Zero-touch)&#xa;• Xuất hóa đơn tạm tính tự động cấn trừ tiền cọc (BR-03)" vertex="1">
          <mxGeometry height="340" width="480" x="1120" y="130" as="geometry" />
        </mxCell>
        <mxCell id="card_mgr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#166534;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;spacingLeft=16;" value="QUẢN LÝ &amp;amp; ADMIN (MANAGEMENT)&#xa;[Kênh: Web Portal Quản trị trên Desktop]&#xa;──────────────────────────────────────&#xa;• Triệt tiêu tổn thất bùng bàn nhờ chính sách đặt cọc VNPAY&#xa;• Giám sát doanh thu và tỷ lệ lấp đầy bàn ăn theo thời gian thực&#xa;• Quản trị thực đơn, giá món &amp;amp; cấu hình sơ đồ bàn ăn&#xa;• Thẩm quyền duyệt hoàn cọc thủ công trong tình huống bất khả kháng&#xa;• Quản lý tài khoản, phân quyền RBAC &amp;amp; báo cáo hiệu quả theo ca" vertex="1">
          <mxGeometry height="300" width="550" x="1090" y="540" as="geometry" />
        </mxCell>
