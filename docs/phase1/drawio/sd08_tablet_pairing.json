{
  "title": "SD-08: Quản trị & Cấu hình Sơ đồ bàn ăn (Floor Plan Configuration)",
  "participants": [
    {
      "id": "mgr",
      "label": "Quản lý (Manager / Admin)",
      "actor": true
    },
    {
      "id": "fe",
      "label": "Manager Web Portal"
    },
    {
      "id": "api",
      "label": "Web API (TableController)"
    },
    {
      "id": "cqrs",
      "label": "MediatR (UpdateFloorPlanCmd)"
    },
    {
      "id": "db",
      "label": "SQL Server (EF Core 9)"
    },
    {
      "id": "hub",
      "label": "SignalR FloorPlanHub"
    },
    {
      "id": "waitstaff",
      "label": "Ứng dụng Phục vụ (Waitstaff)"
    }
  ],
  "messages": [
    {
      "from": "mgr",
      "to": "fe",
      "label": "1. Kéo thả định vị tọa độ bàn (X, Y) & Sức chứa"
    },
    {
      "from": "mgr",
      "to": "fe",
      "label": "2. Bấm 'Lưu thay đổi Sơ đồ bàn'"
    },
    {
      "from": "fe",
      "to": "api",
      "label": "3. PUT /api/admin/tables/layout (TableLayoutDto[])"
    },
    {
      "from": "api",
      "to": "cqrs",
      "label": "4. Send(UpdateFloorPlanCommand)"
    },
    {
      "from": "cqrs",
      "to": "db",
      "label": "5. Kiểm tra mã bàn duy nhất & trạng thái bàn"
    },
    {
      "from": "db",
      "to": "cqrs",
      "label": "6. Dữ liệu hợp lệ (Validation OK)",
      "return": true
    },
    {
      "from": "cqrs",
      "to": "db",
      "label": "7. SaveChangesAsync() lưu tọa độ & khu vực bàn"
    },
    {
      "from": "db",
      "to": "cqrs",
      "label": "8. Commit transaction thành công",
      "return": true
    },
    {
      "from": "cqrs",
      "to": "hub",
      "label": "9. Clients.All.SendAsync(\"FloorPlanConfigUpdated\", layout)",
      "async": true
    },
    {
      "from": "hub",
      "to": "waitstaff",
      "label": "10. Broadcast SignalR tới Tablet phục vụ & Re-render",
      "async": true,
      "activate": false,
      "deactivate": true
    },
    {
      "from": "cqrs",
      "to": "api",
      "label": "11. Return Result.Success()",
      "return": true
    },
    {
      "from": "api",
      "to": "fe",
      "label": "12. 200 OK (LayoutUpdatedResponse)",
      "return": true
    },
    {
      "from": "fe",
      "to": "mgr",
      "label": "13. Hiển thị thông báo lưu thành công & cập nhật trực quan",
      "return": true,
      "activate": false
    }
  ]
}