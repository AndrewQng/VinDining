  <diagram name="Trang-1" id="uQdYlPrtXEr024f0ts6Q">
    <mxGraphModel dx="1598" dy="919" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\n!theme plain\nskinparam linetype ortho\nskinparam nodesep 70\nskinparam ranksep 70\nskinparam packageStyle rectangle\n\npackage \&quot;ENUMS\&quot; {\n    enum TableStatus {\n        Available\n        LockedForPayment\n        Reserved\n        Occupied\n        Cleaning\n    }\n    enum ReservationStatus {\n        AwaitingPayment\n        Confirmed\n        Cancelled\n        Completed\n    }\n    enum OrderItemStatus {\n        Preparing\n        Served\n        Cancelled\n    }\n}\n\npackage \&quot;CONTROLLERS &amp; HUBS (API)\&quot; {\n    class ReservationController &lt;&lt;Controller&gt;&gt;\n    class OrderController &lt;&lt;Controller&gt;&gt;\n    class TableController &lt;&lt;Controller&gt;&gt;\n    class TableHub &lt;&lt;SignalR&gt;&gt;\n    class KitchenHub &lt;&lt;SignalR&gt;&gt;\n}\n\npackage \&quot;SERVICES (CQRS)\&quot; {\n    class ReservationCommandHandler &lt;&lt;Handler&gt;&gt;\n    class OrderCommandHandler &lt;&lt;Handler&gt;&gt;\n    class TableQueryHandler &lt;&lt;Handler&gt;&gt;\n}\n\npackage \&quot;DB ENTITIES (DOMAIN)\&quot; {\n    class Guest {\n        + Guid Id\n        + string FullName\n        + string PhoneNumber\n    }\n    class Table {\n        + Guid Id\n        + string Name\n        + int Capacity\n        + TableStatus Status\n    }\n    class MenuItem {\n        + Guid Id\n        + string Name\n        + decimal Price\n    }\n    class Reservation {\n        + Guid Id\n        + DateTime ReservationTime\n        + int PartySize\n        + ReservationStatus Status\n    }\n    class Order {\n        + Guid Id\n        + Guid TableId\n    }\n    class OrderItem {\n        + Guid Id\n        + int Quantity\n        + OrderItemStatus Status\n    }\n    class Deposit {\n        + Guid Id\n        + decimal Amount\n        + string PaymentMethod\n    }\n    class Invoice {\n        + Guid Id\n        + decimal AmountPayable\n        + bool IsPaid\n    }\n\n    ' Ép layout theo dạng lưới 3 cột x 3 hàng để đường thẳng tắp\n    Guest -[hidden]right-&gt; Table\n    Table -[hidden]right-&gt; MenuItem\n\n    Reservation -[hidden]right-&gt; Order\n    Order -[hidden]right-&gt; OrderItem\n\n    Deposit -[hidden]right-&gt; Invoice\n\n    ' Định nghĩa các quan hệ có cardinality (0..1, 1..*) và chiều mũi tên\n    Guest \&quot;1\&quot; -down-&gt; \&quot;0..*\&quot; Reservation : Makes\n    Table \&quot;1\&quot; -down-&gt; \&quot;0..*\&quot; Reservation : Hosted at\n    Table \&quot;1\&quot; -down-&gt; \&quot;0..*\&quot; Order : Has active\n    \n    OrderItem \&quot;0..*\&quot; -up-&gt; \&quot;1\&quot; MenuItem : Represents\n\n    Reservation \&quot;1\&quot; -down-&gt; \&quot;0..1\&quot; Deposit : Confirmed by\n    Order \&quot;1\&quot; -down-&gt; \&quot;0..1\&quot; Invoice : Billed as\n\n    Order \&quot;1\&quot; -right-&gt; \&quot;1..*\&quot; OrderItem : Contains\n    Order \&quot;0..*\&quot; .-left.&gt; \&quot;0..1\&quot; Reservation : Links to\n}\n\nReservationController ..&gt; ReservationCommandHandler\nOrderController ..&gt; OrderCommandHandler\nTableController ..&gt; TableQueryHandler\n\nReservationCommandHandler --&gt; Reservation\nOrderCommandHandler --&gt; Order\nTableQueryHandler --&gt; Table\n\nTableHub ..&gt; Table\nKitchenHub ..&gt; OrderItem\n\n@enduml&quot;,&#10;  &quot;config&quot;: null&#10;}" id="L4j4HWrY6qfBj0S-LTg2-513">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1720" width="1543.13" as="geometry" />
          </mxCell>
        </UserObject>
