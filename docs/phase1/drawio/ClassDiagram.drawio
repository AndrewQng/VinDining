        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\n\nclass AuthController {\n  + Login(dto)\n  + GetMe()\n  + Logout()\n}\nclass AuthService {\n  + Authenticate(dto): AuthResponseDto\n  + GetCurrentUser(): StaffDto\n  + Logout(): bool\n}\nAuthController ..&gt; AuthService\n\nclass ReservationController {\n  + CreateReservation(dto)\n  + ProcessVnPayIpn(dto)\n  + CancelReservation(dto)\n  + GetReservations()\n  + GetReservationByCode(code: string)\n  + GetAvailableTimeSlots(date: DateOnly)\n}\nclass ReservationService {\n  + CreateReservation(dto): ReservationResultDto\n  + ProcessIpn(dto): IpnResultDto\n  + CancelReservation(code: string): bool\n  + GetReservations(): List&lt;ReservationDto&gt;\n  + GetReservationByCode(code: string): ReservationDto\n  + GetAvailableTimeSlots(date: DateOnly): List&lt;TimeSlotDto&gt;\n}\nReservationController ..&gt; ReservationService\n\nclass TableController {\n  + CheckInReservation(id: Guid, dto)\n  + CheckInWalkIn(id: Guid, dto)\n  + TransferTable(sourceId: Guid, dto)\n  + GetFloorPlan()\n  + GetTableById(id: Guid)\n  + UpdateTableStatus(id: Guid, status: TableStatus)\n}\nclass TableService {\n  + CheckInReservation(dto): bool\n  + CheckInWalkIn(dto): bool\n  + TransferTable(sourceId: Guid, dto): bool\n  + GetFloorPlan(): List&lt;TableDto&gt;\n  + GetTableById(id: Guid): TableDto\n  + UpdateTableStatus(id: Guid, status: TableStatus): bool\n}\nTableController ..&gt; TableService\n\nclass OrderController {\n  + CreateOrderWithCourses(dto)\n  + FireNextCourse(id: Guid, dto)\n  + AddOrderItems(id: Guid, dto)\n  + ConfirmServed(id: Guid, itemId: Guid)\n  + GetActiveOrderByTable(tableId: Guid)\n  + GetOrderDetails(id: Guid)\n  + CancelOrderItem(id: Guid, itemId: Guid)\n  + GetKitchenPendingOrders()\n}\nclass OrderService {\n  + CreateOrderWithCourses(dto): OrderCreatedDto\n  + FireNextCourse(orderId: Guid, courseNo: int): bool\n  + AddOrderItems(orderId: Guid, dto): List&lt;Guid&gt;\n  + ConfirmServed(orderId: Guid, itemId: Guid): bool\n  + GetActiveOrderByTable(tableId: Guid): OrderDto\n  + GetOrderDetails(id: Guid): OrderDto\n  + CancelOrderItem(orderId: Guid, itemId: Guid): bool\n  + GetKitchenPendingOrders(): List&lt;KitchenTicketDto&gt;\n}\nOrderController ..&gt; OrderService\n\nclass InvoiceController {\n  + RequestCheckout(tableId: Guid)\n  + GetInvoicePreview(tableId: Guid)\n  + PrintPreBill(tableId: Guid)\n  + SettleInvoice(tableId: Guid, dto)\n  + GetInvoiceById(id: Guid)\n  + GetInvoices()\n}\nclass InvoiceService {\n  + RequestCheckout(tableId: Guid): bool\n  + CalculateInvoice(tableId: Guid): InvoicePreviewDto\n  + PrintPreBill(tableId: Guid): bool\n  + SettleInvoice(dto): InvoiceSettledDto\n  + GetInvoiceById(id: Guid): InvoiceDto\n  + GetInvoices(): List&lt;InvoiceDto&gt;\n}\nInvoiceController ..&gt; InvoiceService\n\nclass MenuController {\n  + GetTableMenu(id: Guid)\n  + GetCategories()\n  + GetMenuItemById(id: Guid)\n}\nclass MenuService {\n  + GetMenuByTableId(id: Guid): MenuCategoriesDto\n  + GetCategories(): List&lt;CategoryDto&gt;\n  + GetMenuItemById(id: Guid): MenuItemDto\n}\nMenuController ..&gt; MenuService\n\nclass ServiceCallController {\n  + CreateServiceCall(id: Guid, dto)\n  + CompleteServiceCall(id: Guid)\n  + GetActiveServiceCalls()\n}\nclass ServiceCallService {\n  + CreateServiceCall(dto): Guid\n  + CompleteServiceCall(id: Guid): bool\n  + GetActiveServiceCalls(): List&lt;ServiceCallDto&gt;\n}\nServiceCallController ..&gt; ServiceCallService\n\nclass FeedbackController {\n  + SubmitFeedback(dto)\n  + GetFeedbacks()\n}\nclass FeedbackService {\n  + SubmitFeedback(dto): Guid\n  + GetFeedbacks(): List&lt;FeedbackDto&gt;\n}\nFeedbackController ..&gt; FeedbackService\n\nclass AdminMenuController {\n  + CreateMenuItem(dto)\n  + UpdateMenuItem(id: Guid, dto)\n  + UpdateAvailability(id: Guid, dto)\n  + DeleteMenuItem(id: Guid)\n  + GetAllMenuItems(dto)\n  + CreateTastingMenu(dto)\n  + UpdateTastingMenu(id: Guid, dto)\n  + DeleteTastingMenu(id: Guid)\n  + GetAllTastingMenus()\n}\nclass AdminMenuService {\n  + CreateMenuItem(dto): Guid\n  + UpdateMenuItem(id: Guid, dto): bool\n  + UpdateAvailability(dto): bool\n  + DeleteMenuItem(id: Guid): bool\n  + GetAllMenuItems(dto): List&lt;MenuItemDto&gt;\n  + CreateTastingMenu(dto): Guid\n  + UpdateTastingMenu(id: Guid, dto): bool\n  + DeleteTastingMenu(id: Guid): bool\n  + GetAllTastingMenus(): List&lt;TastingMenuDto&gt;\n}\nAdminMenuController ..&gt; AdminMenuService\n\nclass AdminTableController {\n  + UpdateFloorPlanLayout(dto)\n  + CreateTable(dto)\n  + DeleteTable(id: Guid)\n}\nclass AdminTableService {\n  + UpdateFloorPlanLayout(dto): bool\n  + CreateTable(dto): Guid\n  + DeleteTable(id: Guid): bool\n}\nAdminTableController ..&gt; AdminTableService\n\nclass AdminStaffController {\n  + CreateStaff(dto)\n  + UpdateStaff(id: Guid, dto)\n  + ResetPassword(id: Guid)\n  + UpdateStatus(id: Guid, dto)\n  + GetStaffList()\n  + GetStaffById(id: Guid)\n}\nclass StaffService {\n  + CreateStaff(dto): Guid\n  + UpdateStaff(id: Guid, dto): bool\n  + ResetPassword(id: Guid): bool\n  + UpdateStatus(id: Guid, isActive: bool): bool\n  + GetStaffList(): List&lt;StaffDto&gt;\n  + GetStaffById(id: Guid): StaffDto\n}\nAdminStaffController ..&gt; StaffService\n\nclass AdminRefundController {\n  + OverrideRefund(id: Guid, dto)\n  + GetRefundRequests()\n}\nclass RefundService {\n  + OverrideRefund(id: Guid, dto): bool\n  + GetRefundRequests(): List&lt;RefundRequestDto&gt;\n}\nAdminRefundController ..&gt; RefundService\n\nclass ReportController {\n  + GetMetrics(dto)\n  + ExportRevenueReport()\n}\nclass ReportService {\n  + GetMetrics(dto): DashboardDto\n  + ExportRevenueReport(): byte[]\n}\nReportController ..&gt; ReportService\n\nclass CleanupLockService {\n  + ReleaseExpiredLocks(): int\n}\nclass SurveyDispatcherService {\n  + DispatchSurveys(): int\n}\nclass ReservationReminderService {\n  + ScanAndSendReminders(): int\n}\nclass KitchenOrderService {\n  + CheckCookingSlaStatus(): List&lt;SlaAlertDto&gt;\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ud4MxxP9WOwmJYanSN45-504">
