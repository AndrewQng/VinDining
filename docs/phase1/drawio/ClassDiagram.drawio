        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\n\nclass AuthController {\n  – login()\n  – getCurrentUser()\n  – logout()\n}\nclass AuthService {\n  – login()\n  – getCurrentUser()\n  – logout()\n}\nAuthController ..&gt; AuthService\n\nclass ReservationController {\n  – createReservation()\n  – processVnPayIpn()\n  – cancelReservation()\n  – getReservations()\n  – getReservationByCode()\n  – getAvailableTimeSlots()\n}\nclass ReservationService {\n  – createReservation()\n  – processVnPayIpn()\n  – cancelReservation()\n  – getReservations()\n  – getReservationByCode()\n  – getAvailableTimeSlots()\n}\nReservationController ..&gt; ReservationService\n\nclass TableController {\n  – checkInReservation()\n  – checkInWalkIn()\n  – transferTable()\n  – mergeTables()\n  – getFloorPlan()\n  – getTableById()\n  – updateTableStatus()\n}\nclass TableService {\n  – checkInReservation()\n  – checkInWalkIn()\n  – transferTable()\n  – mergeTables()\n  – getFloorPlan()\n  – getTableById()\n  – updateTableStatus()\n}\nTableController ..&gt; TableService\n\nclass OrderController {\n  – createOrderWithCourses()\n  – fireNextCourse()\n  – addOrderItems()\n  – confirmServed()\n  – getActiveOrderByTable()\n  – getOrderDetails()\n  – cancelOrderItem()\n  – getKitchenPendingOrders()\n}\nclass OrderService {\n  – createOrderWithCourses()\n  – fireNextCourse()\n  – addOrderItems()\n  – confirmServed()\n  – getActiveOrderByTable()\n  – getOrderDetails()\n  – cancelOrderItem()\n  – getKitchenPendingOrders()\n}\nOrderController ..&gt; OrderService\n\nclass InvoiceController {\n  – requestCheckout()\n  – getInvoicePreview()\n  – printPreBill()\n  – settleInvoice()\n  – getInvoiceById()\n  – getInvoices()\n}\nclass InvoiceService {\n  – requestCheckout()\n  – calculateInvoice()\n  – printPreBill()\n  – settleInvoice()\n  – getInvoiceById()\n  – getInvoices()\n}\nInvoiceController ..&gt; InvoiceService\n\nclass MenuController {\n  – getTableMenu()\n  – getCategories()\n  – getMenuItemById()\n}\nclass MenuService {\n  – getTableMenu()\n  – getCategories()\n  – getMenuItemById()\n}\nMenuController ..&gt; MenuService\n\nclass ServiceCallController {\n  – createServiceCall()\n  – completeServiceCall()\n  – getActiveServiceCalls()\n}\nclass ServiceCallService {\n  – createServiceCall()\n  – completeServiceCall()\n  – getActiveServiceCalls()\n}\nServiceCallController ..&gt; ServiceCallService\n\nclass FeedbackController {\n  – submitFeedback()\n  – getFeedbacks()\n}\nclass FeedbackService {\n  – submitFeedback()\n  – getFeedbacks()\n}\nFeedbackController ..&gt; FeedbackService\n\nclass AdminMenuController {\n  – createMenuItem()\n  – updateMenuItem()\n  – updateAvailability()\n  – deleteMenuItem()\n  – getAllMenuItems()\n  – createTastingMenu()\n  – updateTastingMenu()\n  – deleteTastingMenu()\n  – getAllTastingMenus()\n}\nclass AdminMenuService {\n  – createMenuItem()\n  – updateMenuItem()\n  – updateAvailability()\n  – deleteMenuItem()\n  – getAllMenuItems()\n  – createTastingMenu()\n  – updateTastingMenu()\n  – deleteTastingMenu()\n  – getAllTastingMenus()\n}\nAdminMenuController ..&gt; AdminMenuService\n\nclass AdminTableController {\n  – updateFloorPlanLayout()\n  – createTable()\n  – deleteTable()\n}\nclass AdminTableService {\n  – updateFloorPlanLayout()\n  – createTable()\n  – deleteTable()\n}\nAdminTableController ..&gt; AdminTableService\n\nclass AdminStaffController {\n  – createStaff()\n  – updateStaff()\n  – resetPassword()\n  – updateStatus()\n  – getStaffList()\n  – getStaffById()\n}\nclass StaffService {\n  – createStaff()\n  – updateStaff()\n  – resetPassword()\n  – updateStatus()\n  – getStaffList()\n  – getStaffById()\n}\nAdminStaffController ..&gt; StaffService\n\nclass AdminRefundController {\n  – overrideRefund()\n  – getRefundRequests()\n}\nclass RefundService {\n  – overrideRefund()\n  – getRefundRequests()\n}\nAdminRefundController ..&gt; RefundService\n\nclass ReportController {\n  – getMetrics()\n  – exportRevenueReport()\n}\nclass ReportService {\n  – getMetrics()\n  – exportRevenueReport()\n}\nReportController ..&gt; ReportService\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ud4MxxP9WOwmJYanSN45-504">
