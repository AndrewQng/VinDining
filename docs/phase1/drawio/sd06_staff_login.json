{
  "title": "SD-06: Đăng nhập hệ thống & Cấp phát JWT Token (UC-E5)",
  "participants": [
    {
      "id": "staff",
      "label": "Nhân viên (Staff)",
      "actor": true
    },
    {
      "id": "fe",
      "label": "Web Frontend"
    },
    {
      "id": "ctrl",
      "label": "AuthController"
    },
    {
      "id": "handler",
      "label": "LoginCommandHandler"
    },
    {
      "id": "identity",
      "label": "IdentityService"
    },
    {
      "id": "jwt",
      "label": "JwtTokenService"
    }
  ],
  "messages": [
    {
      "from": "staff",
      "to": "fe",
      "label": "1. Nhập Username & Password, bấm Đăng nhập"
    },
    {
      "from": "fe",
      "to": "ctrl",
      "label": "2. POST /api/v1/auth/login"
    },
    {
      "from": "ctrl",
      "to": "handler",
      "label": "3. Send(LoginCommand)"
    },
    {
      "from": "handler",
      "to": "identity",
      "label": "4. FindByNameAsync(username)"
    },
    {
      "from": "identity",
      "to": "handler",
      "label": "5. Trả về ApplicationUser & Roles",
      "return": true
    },
    {
      "from": "handler",
      "to": "identity",
      "label": "6. CheckPasswordSignInAsync(user, pass)"
    },
    {
      "note": "[alt: Mật khẩu chính xác & Tài khoản Active]",
      "over": "handler"
    },
    {
      "from": "identity",
      "to": "handler",
      "label": "7a. SignInResult (Success)",
      "return": true
    },
    {
      "from": "handler",
      "to": "jwt",
      "label": "8a. GenerateTokens(user, roles)"
    },
    {
      "from": "jwt",
      "to": "handler",
      "label": "9a. AccessToken (JWT) + RefreshToken",
      "return": true
    },
    {
      "from": "handler",
      "to": "ctrl",
      "label": "10a. AuthResponseDto(AccessToken, Roles, Profile)",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "fe",
      "label": "11a. 200 OK (AuthResponseDto)",
      "return": true
    },
    {
      "from": "fe",
      "to": "fe",
      "label": "12a. Lưu JWT vào Zustand Store & Cookie"
    },
    {
      "from": "fe",
      "to": "staff",
      "label": "13a. Điều hướng màn hình theo Role (Waitstaff/Expediter/Manager)",
      "return": true
    },
    {
      "note": "[else: Thông tin đăng nhập không hợp lệ]",
      "over": "handler"
    },
    {
      "from": "identity",
      "to": "handler",
      "label": "7b. SignInResult (Failed / LockedOut)",
      "return": true
    },
    {
      "from": "handler",
      "to": "ctrl",
      "label": "8b. Result.Failure(\"Invalid credentials\")",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "fe",
      "label": "9b. 401 Unauthorized (\"Tên đăng nhập hoặc mật khẩu không đúng\")",
      "return": true
    },
    {
      "from": "fe",
      "to": "staff",
      "label": "10b. Hiển thị thông báo lỗi màu đỏ & Cho phép nhập lại",
      "return": true
    }
  ]
}