<mxfile host="app.diagrams.net">
  <diagram id="seqlayout" name="SD-11: Quản trị Thực đơn món ăn &amp; Đồng bộ Realtime (UC-A1)">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2250" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Lifelines -->
        <mxCell id="mgr" value="Quản lý (Manager)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-14;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="fe" value="Manager Web Portal" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="290" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Web API (MenuController)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="cqrs" value="MediatR (UpsertMenuCmd)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="790" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="val" value="FluentValidation" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="SQL Server (EF Core 9)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1290" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="hub" value="SignalR Hub" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1540" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="display" value="Digital Display tại bàn" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1790" y="40" width="100" height="920" as="geometry"/>
        </mxCell>
        <mxCell id="staff" value="Tablet Phục vụ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="2040" y="40" width="100" height="920" as="geometry"/>
        </mxCell>

        <!-- Activation Bars -->
        <mxCell id="act_fe" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="fe">
          <mxGeometry x="45" y="80" width="10" height="800" as="geometry"/>
        </mxCell>
        <mxCell id="act_api" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="api">
          <mxGeometry x="45" y="130" width="10" height="710" as="geometry"/>
        </mxCell>
        <mxCell id="act_cqrs" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="cqrs">
          <mxGeometry x="45" y="170" width="10" height="630" as="geometry"/>
        </mxCell>
        <mxCell id="act_val" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="val">
          <mxGeometry x="45" y="210" width="10" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="act_val2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="val">
          <mxGeometry x="45" y="710" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act_db" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="330" width="10" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="act_hub" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="hub">
          <mxGeometry x="45" y="410" width="10" height="120" as="geometry"/>
        </mxCell>

        <!-- Messages 1 to 4 -->
        <mxCell id="m0" value="1. Nhập Tên món, Phân loại Danh mục (Category), Giá bán, Cảnh báo dị ứng" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="mgr" target="act_fe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="200" y="110"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="2. POST /api/v1/menu/items" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_fe" target="act_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="450" y="150"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="3. Send(CreateMenuItemCommand)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_api" target="act_cqrs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="700" y="190"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="4. Validate (Tên, Giá &gt; 0, CategoryId tồn tại)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_cqrs" target="act_val">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="950" y="230"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- Combined Fragment ALT -->
        <mxCell id="frame_alt" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=30;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=none;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="260" width="2135" height="630" as="geometry"/>
        </mxCell>
        <mxCell id="guard_success" value="[Dữ liệu hợp lệ (Tên, Giá &gt; 0, CategoryId tồn tại)]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="295" width="380" height="20" as="geometry"/>
        </mxCell>

        <!-- Branch 1: Success -->
        <mxCell id="m4" value="5a. Validation Passed" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_val" target="act_cqrs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="950" y="310"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="6a. Insert MenuItem &amp; AllergenTags" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_cqrs" target="act_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1050" y="350"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="7a. SaveChangesAsync()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_db" target="act_cqrs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1050" y="390"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="8a. Broadcast MenuCatalogUpdated (kèm xóa Cache)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_cqrs" target="act_hub">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1200" y="430"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="9a. Cập nhật danh mục món trên màn hình Digital Display" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_hub" target="display">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1700" y="470"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="10a. Đồng bộ món &amp; cảnh báo dị ứng trên Tablet phục vụ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_hub" target="staff">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1800" y="510"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="11a. MenuItemDetailDto" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_cqrs" target="act_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="700" y="550"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="12a. 201 Created (Chi tiết món mới)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_api" target="act_fe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="450" y="590"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="13a. Thông báo lưu món thành công trên Dashboard" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_fe" target="mgr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="200" y="630"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- Divider line -->
        <mxCell id="sep_alt" value="[else: Lỗi Validation (Tên rỗng hoặc Giá &lt;= 0)]" style="line;strokeWidth=1;dashed=1;labelPosition=center;verticalLabelPosition=top;align=left;verticalAlign=bottom;spacingLeft=10;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="675" width="2135" height="10" as="geometry"/>
        </mxCell>

        <!-- Branch 2: Validation Failure -->
        <mxCell id="m13_fail" value="5b. Validation Failed (ValidationException)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_val2" target="act_cqrs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="950" y="730"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m14_fail" value="6b. Result.Failure(ValidationErrors)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_cqrs" target="act_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="700" y="770"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m15_fail" value="7b. 400 Bad Request (ValidationErrors)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_api" target="act_fe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="450" y="810"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m16_fail" value="8b. Hiển thị cảnh báo lỗi nhập liệu để Quản lý chỉnh sửa" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#ffffff;fontColor=#ffffff;" edge="1" parent="1" source="act_fe" target="mgr">
          <mxGeometry relative="1" as="geometry">
