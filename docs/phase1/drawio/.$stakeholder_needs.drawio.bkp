<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0" version="26.0.0">
  <diagram name="Khảo sát Nhu cầu Bên liên quan" id="stakeholder_needs">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title_block" value="MÔ HÌNH NHU CẦU CÁC BÊN LIÊN QUAN (STAKEHOLDER VALUE &amp; NEEDS MODEL - VINDINING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="360" y="25" width="1000" height="45" as="geometry"/>
        </mxCell>

        <!-- Central System Hub -->
        <mxCell id="hub_sys" value="HỆ THỐNG VINDINING&#xa;(Core Restaurant Platform)&#xa;──────────────────────────────────────&#xa;• ASP.NET Core (.NET 9) Web API &amp; MediatR CQRS&#xa;• Real-time Floor &amp; Kitchen Hubs (SignalR)&#xa;• Cổng thanh toán cọc tự động VNPAY (BR-01, BR-05)&#xa;• Module chia lệnh in nhiệt ESC/POS trạm Bếp/Bar&#xa;• Màn hình E-Menu hiển thị thực đơn tĩnh tại bàn (BR-02)&#xa;• Tự động cấn trừ tiền cọc vào hóa đơn (BR-03)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="380" width="380" height="210" as="geometry"/>
        </mxCell>

        <!-- 1. Thực khách (Guest) - Top Left -->
        <mxCell id="card_guest" value="THỰC KHÁCH (GUEST)&#xa;[Kênh: Mobile Web / Digital Display tại bàn]&#xa;──────────────────────────────────────&#xa;• Đặt bàn trực tuyến &amp; chọn trước vị trí mong muốn&#xa;• Đặt cọc an toàn qua VNPAY (giữ bàn 17 phút - BR-01)&#xa;• Không cần đăng ký tài khoản, tra cứu bằng BookingCode&#xa;• Xem menu trực quan trên Digital Display tại bàn (BR-02)&#xa;• Nhận hoàn cọc 100% tự động khi hủy trước &gt;= 4h (BR-05)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="380" height="190" as="geometry"/>
        </mxCell>

        <!-- 3. Điều phối (Expediter) - Middle Left -->
        <mxCell id="card_expediter" value="ĐIỀU PHỐI VIÊN (EXPEDITER)&#xa;[Kênh: Tablet cố định tại quầy Pass]&#xa;──────────────────────────────────────&#xa;• Nhận đĩa món chế biến hoàn tất từ Bếp tại quầy Pass&#xa;• Kiểm tra đĩa món, đối chiếu vé in &amp; kiểm soát dị ứng&#xa;• Thẩm quyền độc quyền bấm 'Xác nhận ra món' (BR-04)&#xa;• Chuyển trạng thái sang Served &amp; lưu ServeTimestamp&#xa;• Đảm bảo chất lượng &amp; nhịp độ bưng món chuẩn Fine Dining" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#6b21a8;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="380" height="190" as="geometry"/>
        </mxCell>

        <!-- 4. Nhà bếp (Kitchen Operations) - Bottom Left -->
        <mxCell id="card_kitchen" value="BỘ PHẬN BẾP (KITCHEN OPERATIONS)&#xa;[Kênh: Máy in nhiệt ESC/POS mạng LAN/Wi-Fi]&#xa;──────────────────────────────────────&#xa;• Tự động nhả phiếu in order tại Bếp nóng, Bếp lạnh, Bar&#xa;• Cảnh báo dị ứng in đậm, triệt tiêu sai sót chữ viết tay&#xa;• Phiếu in phân nhóm rõ ràng theo từng Course món ăn&#xa;• Không chạm màn hình cảm ứng trong môi trường nấu nướng&#xa;• Ra món đúng tiêu chuẩn ẩm thực cao cấp và chuyển Pass" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="380" height="190" as="geometry"/>
        </mxCell>

        <!-- 2. Nhân viên Phục vụ (Waitstaff) - Top Right -->
        <mxCell id="card_staff" value="NHÂN VIÊN PHỤC VỤ (WAITSTAFF)&#xa;[Kênh: Tablet POS cầm tay tại phòng ăn]&#xa;──────────────────────────────────────&#xa;• Theo dõi sơ đồ bàn trực quan theo thời gian thực (SignalR)&#xa;• Check-in khách vào bàn (Occupied) &amp; kích hoạt phiên dùng bữa&#xa;• Tư vấn gọi món &amp; tạo Order ngay tại bàn kích hoạt in Bếp&#xa;• Nhận đĩa món đã kiểm tra từ quầy Pass bưng phục vụ khách&#xa;• Xuất hóa đơn tạm tính tự động cấn trừ tiền cọc (BR-03)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="1280" y="160" width="380" height="190" as="geometry"/>
        </mxCell>

        <!-- 5. Quản lý & Admin (Manager & Admin) - Bottom Right -->
        <mxCell id="card_mgr" value="QUẢN LÝ &amp; ADMIN (MANAGEMENT)&#xa;[Kênh: Web Portal Quản trị trên Desktop]&#xa;──────────────────────────────────────&#xa;• Triệt tiêu tổn thất bùng bàn nhờ chính sách đặt cọc VNPAY&#xa;• Giám sát doanh thu và tỷ lệ lấp đầy bàn ăn theo thời gian thực&#xa;• Quản trị thực đơn, giá món &amp; cấu hình sơ đồ bàn ăn&#xa;• Thẩm quyền duyệt hoàn cọc thủ công trong tình huống bất khả kháng&#xa;• Quản lý tài khoản, phân quyền RBAC &amp; báo cáo hiệu quả theo ca" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#166534;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="1280" y="600" width="380" height="190" as="geometry"/>
        </mxCell>

        <!-- Connectors -->
        <!-- Guest -> Hub -->
        <mxCell id="e_g_hub" value="Đặt bàn, xem Menu&#xa;&amp; thanh toán cọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284c7;strokeWidth=2;html=1;fontSize=10;fontColor=#0369a1;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.2;entryY=0;" edge="1" source="card_guest" target="hub_sys" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Expediter -> Hub -->
        <mxCell id="e_e_hub" value="Xác nhận ra món&#xa;&amp; kiểm đồ tại Pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333ea;strokeWidth=2;html=1;fontSize=10;fontColor=#6b21a8;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="card_expediter" target="hub_sys" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Hub -> Kitchen -->
        <mxCell id="e_k_hub" value="Lệnh in nhiệt ESC/POS&#xa;phân trạm Bếp/Bar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#dc2626;strokeWidth=2;html=1;fontSize=10;fontColor=#991b1b;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" source="hub_sys" target="card_kitchen" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Staff -> Hub -->
        <mxCell id="e_w_hub" value="Sơ đồ bàn, tạo đơn&#xa;&amp; đóng bàn phục vụ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d97706;strokeWidth=2;html=1;fontSize=10;fontColor=#92400e;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.8;entryY=0;" edge="1" source="card_staff" target="hub_sys" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Manager -> Hub -->
        <mxCell id="e_m_hub" value="Báo cáo doanh thu,&#xa;cấu hình &amp; phân quyền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;html=1;fontSize=10;fontColor=#166534;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.8;entryY=1;" edge="1" source="card_mgr" target="hub_sys" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
