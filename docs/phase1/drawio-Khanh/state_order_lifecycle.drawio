<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0" version="26.0.0">
  <diagram name="State Machine Vòng đời Đơn hàng & Món" id="state_order_lifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title block -->
        <mxCell id="title_box" value="SƠ ĐỒ MÁY TRẠNG THÁI VÒNG ĐỜI ĐƠN HÀNG &amp; MÓN ĂN (ORDER &amp; ITEM LIFECYCLE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="740" height="40" as="geometry"/>
        </mxCell>

        <!-- Initial State -->
        <mxCell id="init_state" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- State 1: Pending -->
        <mxCell id="st_pending" value="Pending (Chờ duyệt)&#xa;----------------------------&#xa;entry / Tạo Order trên DB; Phát SignalR&#xa;do / Hiển thị rung trên Tablet Phục vụ&#xa;exit / Phục vụ bấm 'Phê duyệt'" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="210" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- State Cancelled -->
        <mxCell id="st_cancelled" value="Cancelled (Hủy bỏ)&#xa;----------------------------&#xa;entry / Hủy đơn; Giải phóng món&#xa;do / Lưu vết hủy đơn vào audit log" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#757575;strokeColor=#424242;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="390" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- State 2: Processing -->
        <mxCell id="st_processing" value="Processing (Đang nấu / In Bếp)&#xa;---------------------------------------&#xa;entry / Bắn lệnh in nhiệt ESC/POS phân trạm&#xa;do / Đầu bếp chế biến theo Course&#xa;exit / Món hoàn thành, đặt ra Pass" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="210" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- State 3: Ready -->
        <mxCell id="st_ready" value="Ready (Sẵn sàng tại Pass)&#xa;---------------------------------&#xa;entry / Chuông báo đĩa món hoàn tất&#xa;do / Món nằm trên đĩa giữ nhiệt ở Pass&#xa;exit / Phục vụ lấy đĩa mang ra bàn" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="210" width="230" height="90" as="geometry"/>
        </mxCell>

        <!-- State 4: Served -->
        <mxCell id="st_served" value="Served (Đã phục vụ tại bàn)&#xa;------------------------------------&#xa;entry / Lưu ServeTimestamp; Cập nhật sơ đồ&#xa;do / Khách dùng món tiệc tại bàn&#xa;exit / Khách kết thúc bữa ăn" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="440" width="230" height="90" as="geometry"/>
        </mxCell>

        <!-- State 5: Paid / Completed -->
        <mxCell id="st_paid" value="Paid / Completed (Đã thanh toán)&#xa;-----------------------------------------&#xa;entry / Áp công thức BR-03; Cấn trừ cọc&#xa;do / In hóa đơn tài chính cuối cùng" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="440" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- Final State -->
        <mxCell id="end_state" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="end_state_dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="466" y="606" width="18" height="18" as="geometry"/>
        </mxCell>

        <!-- Final State Cancelled -->
        <mxCell id="end_cancel" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="end_cancel_dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="66" y="416" width="18" height="18" as="geometry"/>
        </mxCell>

        <!-- Transitions -->
        <!-- init -> Pending -->
        <mxCell id="tr0" value="Khách quét QR gửi đơn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;" edge="1" source="init_state" target="st_pending" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Pending -> Cancelled -->
        <mxCell id="tr_can" value="Khách hủy trước khi duyệt&#xa;/ Xóa đơn tạm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#757575;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="st_pending" target="st_cancelled" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cancelled -> end -->
        <mxCell id="tr_can_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#757575;strokeWidth=1.5;html=1;" edge="1" source="st_cancelled" target="end_cancel" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Pending -> Processing -->
        <mxCell id="tr1" value="Phục vụ đối soát dị ứng &amp; Bấm 'Phê duyệt'&#xa;/ Gửi ESC/POS in Bếp &amp; Ghi giờ bắt đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="st_pending" target="st_processing" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Processing -> Ready -->
        <mxCell id="tr2" value="Đầu bếp nấu xong đĩa món&#xa;/ Đặt ra quầy Pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="st_processing" target="st_ready" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Ready -> Served -->
        <mxCell id="tr3" value="Phục vụ bưng món ra bàn cho khách&#xa;&amp; Bấm 'Xác nhận hoàn thành món' (BR-04)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#2e7d32;" edge="1" source="st_ready" target="st_served" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Served -> Paid -->
        <mxCell id="tr4" value="Yêu cầu thanh toán &amp; Thu ngân đóng bàn&#xa;/ Áp công thức BR-03 cấn trừ cọc thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="st_served" target="st_paid" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Paid -> End -->
        <mxCell id="tr5" value="Đóng phiên đơn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;" edge="1" source="st_paid" target="end_state" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="570"/>
              <mxPoint x="475" y="570"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Note on Allergies & Course progression -->
        <mxCell id="note1" value="📌 QUY TẮC ĐIỀU PHỐI COURSE:&#xa;Đơn hàng có thể chia thành nhiều món con (OrderItem).&#xa;Mỗi OrderItem chuyển từ Processing -&gt; Ready -&gt; Served&#xa;độc lập theo tiến độ phục vụ bàn ăn thực tế." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#b45f06;fontSize=10;fontStyle=1;size=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="520" width="260" height="70" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
