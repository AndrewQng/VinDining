<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0" version="26.0.0">
  <diagram name="State Machine Vòng đời Bàn ăn" id="state_table_lifecycle">
    <mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title block -->
        <mxCell id="title_box" value="SƠ ĐỒ MÁY TRẠNG THÁI VÒNG ĐỜI BÀN ĂN (TABLE LIFECYCLE STATE MACHINE - VINDINING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="700" height="35" as="geometry"/>
        </mxCell>

        <!-- Initial State -->
        <mxCell id="init_state" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="265" y="190" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- State 1: Available -->
        <mxCell id="st_avail" value="Available (Bàn trống)&#xa;──────────────────────────────&#xa;entry / Hiển thị xanh trên sơ đồ bàn&#xa;do / Chờ khách đặt chỗ hoặc Walk-in&#xa;exit / Khóa chọn trên sơ đồ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="340" width="240" height="100" as="geometry"/>
        </mxCell>

        <!-- State 2: LockedForPayment -->
        <mxCell id="st_hold" value="LockedForPayment (Khóa giữ cọc 17p)&#xa;──────────────────────────────&#xa;entry / Bắt đầu đếm ngược 17 phút (BR-01)&#xa;do / Chờ xác thực thanh toán qua VNPAY&#xa;exit / Dừng bộ đếm Timer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="160" width="260" height="90" as="geometry"/>
        </mxCell>

        <!-- State 3: Reserved -->
        <mxCell id="st_res" value="Reserved (Đã đặt cọc)&#xa;──────────────────────────────&#xa;entry / Sinh BookingCode &amp; gửi SMS/Email&#xa;do / Khóa bàn theo ca hẹn &amp; giữ cọc&#xa;exit / Chuẩn bị bàn đón khách" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="340" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- State 4: Occupied -->
        <mxCell id="st_occ" value="Occupied (Đang phục vụ)&#xa;──────────────────────────────&#xa;entry / Check-in bàn trên Tablet (BR-02)&#xa;do / Khách xem Digital Display &amp; Bếp ra món&#xa;exit / Khách yêu cầu thanh toán" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="490" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- State 5: Cleaning -->
        <mxCell id="st_clean" value="Cleaning (Chờ dọn dẹp)&#xa;──────────────────────────────&#xa;entry / Đóng hóa đơn &amp; ghi nhận doanh thu&#xa;do / Waitstaff thu dọn &amp; set up bàn mới&#xa;exit / Bàn sạch theo tiêu chuẩn Fine Dining" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="700" width="240" height="100" as="geometry"/>
        </mxCell>

        <!-- Final State -->
        <mxCell id="end_state" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="265" y="910" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Transitions -->
        <!-- init -> Available -->
        <mxCell id="tr0" value="Khởi tạo&#xa;sơ đồ bàn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="init_state" target="st_avail" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Available -> LockedForPayment -->
        <mxCell id="tr1" value="Khách chọn bàn&#xa;&amp; ấn Đặt cọc [BR-01]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.5;entryY=0;" edge="1" source="st_avail" target="st_hold" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="125"/>
              <mxPoint x="670" y="125"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LockedForPayment -> Available (Timeout) -->
        <mxCell id="tr2" value="Hết 17 phút chưa cọc&#xa;/ Mở khóa tự động [BR-01]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#dc2626;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#b91c1c;exitX=0.2;exitY=1;entryX=0.85;entryY=0;" edge="1" source="st_hold" target="st_avail" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="592" y="290"/>
              <mxPoint x="364" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LockedForPayment -> Reserved -->
        <mxCell id="tr3" value="IPN VNPAY thành công&#xa;/ Nhận cọc &amp; cấp mã" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16a34a;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#15803d;exitX=0.85;exitY=1;entryX=0.25;entryY=0;" edge="1" source="st_hold" target="st_res" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="761" y="290"/>
              <mxPoint x="985" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reserved -> Available (Cancel / No-show) -->
        <mxCell id="tr4" value="Hủy bàn / No-show [BR-05]&#xa;Hoàn cọc nếu ≥ 4h;&#xa;Phạt cọc nếu &lt; 4h hoặc trễ 30p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.25;entryY=0;" edge="1" source="st_res" target="st_avail" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="85"/>
              <mxPoint x="220" y="85"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reserved -> Occupied -->
        <mxCell id="tr5" value="Khách đến nhận bàn&#xa;/ Waitstaff Check-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" source="st_res" target="st_occ" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="972" y="540"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Available -> Occupied (Walk-in) -->
        <mxCell id="tr6" value="Khách vãng lai (Walk-in)&#xa;/ Mở bàn phục vụ ngay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0;entryY=0.5;" edge="1" source="st_avail" target="st_occ" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="364" y="540"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Occupied -> Cleaning -->
        <mxCell id="tr7" value="Thanh toán thành công&#xa;cấn trừ tiền cọc [BR-03]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" source="st_occ" target="st_clean" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="750"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cleaning -> Available -->
        <mxCell id="tr8" value="Dọn dẹp hoàn tất&#xa;/ Sẵn sàng đón khách" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#16a34a;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#15803d;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="st_clean" target="st_avail" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="80" y="750"/>
              <mxPoint x="80" y="390"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cleaning -> end -->
        <mxCell id="tr9" value="Hết ca&#xa;đóng cửa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;strokeWidth=1.5;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="st_clean" target="end_state" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SignalR Callout -->
        <mxCell id="callout_hub" value="⚡ ĐỒNG BỘ TRẠNG THÁI THỜI GIAN THỰC:&#xa;Tất cả sự kiện thay đổi trạng thái bàn ăn&#xa;đều được broadcast tức thời (&lt; 100ms)&#xa;qua FloorPlanHub (ASP.NET Core SignalR)&#xa;tới toàn bộ thiết bị Tablet và POS." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#6b21a8;fontSize=10;fontStyle=1;size=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="680" width="280" height="95" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
