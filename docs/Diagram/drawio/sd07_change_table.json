{
  "title": "SD-07: Đổi bàn & Ghép bàn trong ca phục vụ (UC-E4)",
  "participants": [
    {
      "id": "guest",
      "label": "Khách hàng (Guest)",
      "actor": true
    },
    {
      "id": "waitstaff",
      "label": "Phục vụ (Waitstaff)",
      "actor": true
    },
    {
      "id": "tablet",
      "label": "Waitstaff Tablet"
    },
    {
      "id": "ctrl",
      "label": "TableController"
    },
    {
      "id": "handler",
      "label": "ChangeTableCommandHandler"
    },
    {
      "id": "db",
      "label": "AppDbContext"
    },
    {
      "id": "hub",
      "label": "TableHub (SignalR)"
    },
    {
      "id": "exp",
      "label": "Điều phối (Expediter)"
    }
  ],
  "messages": [
    {
      "from": "guest",
      "to": "waitstaff",
      "label": "1. Yêu cầu chuyển sang bàn khác (VD: Ra ban công)"
    },
    {
      "from": "waitstaff",
      "to": "tablet",
      "label": "2. Chọn chức năng Đổi bàn trên giao diện"
    },
    {
      "from": "tablet",
      "to": "ctrl",
      "label": "3. GET /api/v1/tables/available"
    },
    {
      "from": "ctrl",
      "to": "db",
      "label": "4. Query các bàn trống (Status = Available)"
    },
    {
      "from": "db",
      "to": "ctrl",
      "label": "5. Danh sách bàn trống khả dụng",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "tablet",
      "label": "6. 200 OK (Danh sách bàn)",
      "return": true
    },
    {
      "note": "[alt: Có bàn trống phù hợp]",
      "over": "tablet"
    },
    {
      "from": "waitstaff",
      "to": "tablet",
      "label": "7a. Chọn bàn mới mục tiêu & Xác nhận chuyển"
    },
    {
      "from": "tablet",
      "to": "ctrl",
      "label": "8a. POST /api/v1/tables/change-table"
    },
    {
      "from": "ctrl",
      "to": "handler",
      "label": "9a. Send(ChangeTableCommand)"
    },
    {
      "from": "handler",
      "to": "db",
      "label": "10a. Cập nhật Order.TableId, Bàn cũ = Cleaning, Bàn mới = Occupied & SaveChangesAsync()"
    },
    {
      "from": "db",
      "to": "handler",
      "label": "11a. Commit Transaction thành công",
      "return": true
    },
    {
      "from": "handler",
      "to": "hub",
      "label": "12a. Broadcast sự kiện TableChanged (tableId, newTableId, orderId)"
    },
    {
      "from": "hub",
      "to": "exp",
      "label": "13a. Cập nhật số bàn mới cho các món đang chế biến",
      "return": true
    },
    {
      "from": "hub",
      "to": "tablet",
      "label": "14a. Sync sơ đồ bàn: Bàn cũ (Cleaning), Bàn mới (Occupied)",
      "return": true
    },
    {
      "from": "handler",
      "to": "ctrl",
      "label": "15a. Result (Success)",
      "return": true
    },
    {
      "from": "ctrl",
      "to": "tablet",
      "label": "16a. 200 OK (Chuyển bàn thành công)",
      "return": true
    },
    {
      "from": "tablet",
      "to": "waitstaff",
      "label": "17a. Thông báo thành công & Mở đơn bàn mới",
      "return": true
    },
    {
      "from": "waitstaff",
      "to": "guest",
      "label": "18a. Mời khách di chuyển sang vị trí bàn mới"
    },
    {
      "note": "[else: Hết bàn trống khả dụng]",
      "over": "tablet"
    },
    {
      "from": "tablet",
      "to": "waitstaff",
      "label": "7b. Hiển thị thông báo không còn bàn trống phù hợp",
      "return": true
    },
    {
      "from": "waitstaff",
      "to": "guest",
      "label": "8b. Thông báo hết bàn & xin lỗi thực khách"
    }
  ]
}