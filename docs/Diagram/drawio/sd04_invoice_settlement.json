{
  "title": "SD-04: Thanh toán hóa đơn, Cấn trừ cọc & Đóng bàn",
  "participants": [
    {
      "id": "g",
      "label": "Khách hàng (Guest)",
      "actor": true
    },
    {
      "id": "w",
      "label": "Phục vụ (Waitstaff)",
      "actor": true
    },
    {
      "id": "tab",
      "label": "Tablet POS Phục vụ"
    },
    {
      "id": "api",
      "label": "Web API (.NET 9)"
    },
    {
      "id": "db",
      "label": "SQL Server"
    },
    {
      "id": "hub",
      "label": "SignalR Hub"
    },
    {
      "id": "disp",
      "label": "Màn hình TableDisplay tại bàn"
    },
    {
      "id": "prn",
      "label": "Máy in Hóa đơn"
    }
  ],
  "messages": [
    {
      "from": "g",
      "to": "w",
      "label": "1. Yêu cầu tính tiền trực tiếp (lời nói / cử chỉ)"
    },
    {
      "from": "w",
      "to": "tab",
      "label": "2. Chọn 'Thanh toán bàn' trên Tablet POS"
    },
    {
      "from": "tab",
      "to": "api",
      "label": "3. GET /api/invoices/preview/{tableId}"
    },
    {
      "from": "api",
      "to": "db",
      "label": "4. Query tiền món & tiền cọc Deposit"
    },
    {
      "from": "db",
      "to": "api",
      "label": "5. Trả về dữ liệu chi tiết",
      "return": true
    },
    {
      "from": "api",
      "to": "api",
      "label": "6. Áp công thức BR-03 (Subtotal + 5% SVC + 10% VAT - Deposit)"
    },
    {
      "from": "api",
      "to": "hub",
      "label": "7. Broadcast BillPreview (Chi tiết hóa đơn & Dynamic VietQR)"
    },
    {
      "from": "hub",
      "to": "disp",
      "label": "8. TableDisplay hiển thị bảng kê hóa đơn & mã VietQR động"
    },
    {
      "from": "api",
      "to": "tab",
      "label": "9. 200 OK (Chi tiết hóa đơn tạm tính)",
      "return": true
    },
    {
      "from": "g",
      "to": "disp",
      "label": "10. Khách kiểm tra hóa đơn trên TableDisplay (hoặc phiếu tạm tính)"
    },
    {
      "from": "g",
      "to": "w",
      "label": "11. Thanh toán số dư còn thiếu (Quét VietQR TableDisplay / Thẻ POS / Tiền mặt)"
    },
    {
      "from": "w",
      "to": "tab",
      "label": "12. Chọn phương thức & Bấm 'Hoàn tất thanh toán'"
    },
    {
      "from": "tab",
      "to": "api",
      "label": "13. POST /api/invoices/settle { tableId, paymentMethod }"
    },
    {
      "from": "api",
      "to": "db",
      "label": "14. Cập nhật Invoice -> Paid, Table -> Cleaning"
    },
    {
      "from": "api",
      "to": "hub",
      "label": "15. Broadcast PaymentSettled (tableId)"
    },
    {
      "from": "hub",
      "to": "disp",
      "label": "16. TableDisplay hiển thị thông điệp cảm ơn thực khách"
    },
    {
      "from": "api",
      "to": "prn",
      "label": "17. In hóa đơn tài chính cuối cùng (kèm PaymentMethod)"
    },
    {
      "from": "api",
      "to": "tab",
      "label": "18. 200 OK (Thanh toán hoàn tất thành công)",
      "return": true
    },
    {
      "from": "api",
      "to": "hub",
      "label": "19. Broadcast TableStatusChanged(tableId, 'Cleaning')"
    }
  ]
}