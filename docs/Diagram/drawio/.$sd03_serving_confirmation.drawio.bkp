<mxfile host="Electron">
  <diagram id="sd03_layout" name="SD-03: Kiểm đồ tại Pass, Xác nhận ra món (Served) &amp; Phục vụ bàn">
    <mxGraphModel dx="2357" dy="1402" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. Nhà bếp & KDS -->
        <mxCell id="k" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-14;labelBackgroundColor=#ffffff;fontSize=15;fontStyle=1;strokeColor=#333333;" value="Nhà bếp &amp; KDS" vertex="1">
          <mxGeometry height="760" width="100" x="50" y="40" as="geometry" />
        </mxCell>

        <!-- 2. Điều phối (Expediter) -->
        <mxCell id="exp" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-14;labelBackgroundColor=#ffffff;fontSize=15;fontStyle=1;strokeColor=#333333;" value="Điều phối&#xa;(Expediter)" vertex="1">
          <mxGeometry height="760" width="110" x="210" y="40" as="geometry" />
        </mxCell>
        <mxCell id="act_exp" parent="exp" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" value="" vertex="1">
          <mxGeometry height="610" width="10" x="50" y="70" as="geometry" />
        </mxCell>

        <!-- 3. Phục vụ (Waitstaff) -->
        <mxCell id="w" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-14;labelBackgroundColor=#ffffff;fontSize=15;fontStyle=1;strokeColor=#333333;" value="Phục vụ&#xa;(Waitstaff)" vertex="1">
          <mxGeometry height="760" width="110" x="380" y="40" as="geometry" />
        </mxCell>
        <mxCell id="act_w" parent="w" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" value="" vertex="1">
          <mxGeometry height="230" width="10" x="50" y="450" as="geometry" />
        </mxCell>

        <!-- 4. Pass Tablet tại Pass -->
        <mxCell id="tab" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" value="Pass Tablet tại Pass" vertex="1">
          <mxGeometry height="760" width="130" x="550" y="40" as="geometry" />
        </mxCell>
        <mxCell id="act_tab" parent="tab" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" value="" vertex="1">
          <mxGeometry height="440" width="10" x="60" y="180" as="geometry" />
        </mxCell>

        <!-- 5. OrderController -->
        <mxCell id="ctrl" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" value="OrderController" vertex="1">
          <mxGeometry height="760" width="140" x="740" y="40" as="geometry" />
        </mxCell>
        <mxCell id="act_ctrl" parent="ctrl" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" value="" vertex="1">
          <mxGeometry height="350" width="10" x="65" y="230" as="geometry" />
        </mxCell>

        <!-- 6. ConfirmServingHandler -->
        <mxCell id="handler" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" value="ConfirmServingHandler" vertex="1">
          <mxGeometry height="760" width="160" x="940" y="40" as="geometry" />
        </mxCell>
        <mxCell id="act_h" parent="handler" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" value="" vertex="1">
          <mxGeometry height="260" width="10" x="75" y="280" as="geometry" />
        </mxCell>

        <!-- 7. AppDbContext -->
        <mxCell id="db" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" value="AppDbContext" vertex="1">
          <mxGeometry height="760" width="130" x="1160" y="40" as="geometry" />
        </mxCell>
        <mxCell id="act_db" parent="db" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" value="" vertex="1">
          <mxGeometry height="100" width="10" x="60" y="330" as="geometry" />
        </mxCell>

        <!-- Messages Flow -->
        <!-- 1. Đặt món xong ra quầy Pass -->
        <mxCell id="m0" edge="1" parent="1" source="k" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1053;entryX=0;entryY=0.0164;fontSize=14;" target="act_exp" value="1. Đặt đĩa món xong ra quầy Pass">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Kiểm tra thẩm mỹ, nhiệt độ & dị ứng món ăn -->
        <mxCell id="m1" edge="1" parent="1" source="act_exp" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;html=1;exitX=1;exitY=0.0820;entryX=1;entryY=0.1311;strokeColor=#333333;fontColor=#333333;fontSize=14;" target="act_exp" value="2. Kiểm tra thẩm mỹ, nhiệt độ &amp; dị ứng món">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="160" />
              <mxPoint x="340" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. Chạm nút "Xác nhận ra món" (Served) -->
        <mxCell id="m2" edge="1" parent="1" source="act_exp" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1967;entryX=0;entryY=0.0227;fontSize=14;" target="act_tab" value="3. Chạm nút &quot;Xác nhận ra món&quot; (Served)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. PATCH /api/orders/{orderId}/items/{itemId}/serve -->
        <mxCell id="m3" edge="1" parent="1" source="act_tab" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1364;entryX=0;entryY=0.0286;fontSize=14;" target="act_ctrl" value="4. PATCH /api/orders/{orderId}/items/{itemId}/serve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. Send(ConfirmServingCommand) -->
        <mxCell id="m4" edge="1" parent="1" source="act_ctrl" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1714;entryX=0;entryY=0.0385;fontSize=14;" target="act_h" value="5. Send(ConfirmServingCommand)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. Update OrderItem -> Served -->
        <mxCell id="m5" edge="1" parent="1" source="act_h" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2308;entryX=0;entryY=0.1000;fontSize=14;" target="act_db" value="6. Update(OrderItem -&gt; Served, ServedAt = UtcNow)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. SaveChangesAsync() -->
        <mxCell id="m6" edge="1" parent="1" source="act_h" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3846;entryX=0;entryY=0.5000;fontSize=14;" target="act_db" value="7. SaveChangesAsync()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. Xác nhận CSDL thành công -->
        <mxCell id="m7" edge="1" parent="1" source="act_db" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.9000;entryX=1;entryY=0.5385;fontSize=14;" target="act_h" value="8. Xác nhận cập nhật CSDL thành công">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. SignalR: Báo rung điện thoại Waitstaff -->
        <mxCell id="m8" edge="1" parent="1" source="act_h" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#333333;fontColor=#333333;exitX=0;exitY=0.6923;entryX=1;entryY=0.0435;fontSize=14;" target="act_w" value="9. SignalR: Báo rung điện thoại Waitstaff (Món sẵn sàng tại Pass)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. ServingConfirmedResponseDto -->
        <mxCell id="m9" edge="1" parent="1" source="act_h" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.8462;entryX=1;entryY=0.7714;fontSize=14;" target="act_ctrl" value="10. ServingConfirmedResponseDto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 11. 200 OK (Status: Served) -->
        <mxCell id="m10" edge="1" parent="1" source="act_ctrl" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#666666;fontColor=#333333;exitX=0;exitY=0.9143;entryX=1;entryY=0.8409;fontSize=14;" target="act_tab" value="11. 200 OK (Status: Served)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 12. Bàn giao đĩa món cho Waitstaff -->
        <mxCell id="m11" edge="1" parent="1" source="act_exp" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.9180;entryX=0;entryY=0.7826;fontSize=14;" target="act_w" value="12. Bàn giao đĩa món cho Waitstaff bưng phục vụ bàn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
