@startuml SD_UC_U3_Cancel_Reservation
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14

actor "Khách hàng" as Guest
boundary "Giao diện Web" as UI
control "ReservationController" as Controller
participant "ReservationService" as Service
participant "ReservationRepository" as Repo
database "SQL Server" as DB
participant "VNPAY" as VNPAY

Guest -> UI: Nhập BookingCode & Bấm Hủy
activate UI

UI -> Controller: POST /api/reservations/cancel
activate Controller

Controller -> Service: CancelReservation(code)
activate Service

Service -> Repo: GetByCode(code)
activate Repo

Repo -> DB: SELECT Reservations
activate DB
DB --> Repo: reservation
deactivate DB

Repo --> Service: reservation
deactivate Repo

Service -> Service: CheckCancelPolicy(reservation)

alt Trước giờ hẹn >= 4 tiếng (Hoàn cọc)
    Service -> VNPAY: RefundRequest(code, amount)
    activate VNPAY
    VNPAY --> Service: RefundSuccess (00)
    deactivate VNPAY

    Service -> Repo: CancelAndReleaseTable(id, "Refunded")
    activate Repo
    Repo -> DB: UPDATE Reservations, Tables
    activate DB
    DB --> Repo: OK
    deactivate DB
    Repo --> Service: OK
    deactivate Repo

else Trước giờ hẹn < 4 tiếng (Không hoàn cọc)
    Service -> Repo: CancelAndReleaseTable(id, "Forfeited")
    activate Repo
    Repo -> DB: UPDATE Reservations, Tables
    activate DB
    DB --> Repo: OK
    deactivate DB
    Repo --> Service: OK
    deactivate Repo
end

Service --> Controller: CancelResult(status, message)
deactivate Service

Controller --> UI: 200 OK
deactivate Controller

UI --> Guest: Thông báo hủy thành công
deactivate UI

@enduml