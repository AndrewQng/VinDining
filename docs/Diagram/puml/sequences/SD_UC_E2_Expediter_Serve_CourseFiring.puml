@startuml SD_UC_E2_Expediter_Serve_CourseFiring
autonumber
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14

actor "Nhân viên Điều phối" as Expediter
boundary "Giao diện Web" as UI
control "OrderController" as Controller
participant "OrderService" as Service
participant "OrderRepository" as Repo
database "SQL Server" as DB

Expediter -> UI: Đối chiếu đĩa món với đơn trên màn hình Pass
activate UI

alt Món không đạt yêu cầu (UC-E3, 2a)
    UI -> Controller: POST /api/orders/{id}\n/items/{itemId}/remake
    activate Controller
    Controller -> Service: RequestRemake(id, itemId)
    activate Service
    Service -> UI: PushSignalR("Kitchen_Remake")
    Service --> Controller: Result(Success)
    deactivate Service
    Controller --> UI: 200 OK
    deactivate Controller
    UI --> Expediter: Đã gửi yêu cầu làm lại tới bếp
else Món đạt yêu cầu
Expediter -> UI: Bấm Xác nhận đi món (Served)

UI -> Controller: PATCH /api/orders/{id}\n/items/{itemId}/serve
activate Controller

Controller -> Service: ConfirmServed(id, itemId)
activate Service

Service -> Repo: UpdateItemServed(itemId)
activate Repo
Repo -> DB: UPDATE OrderItems \nSET Status = 'Served'
activate DB
DB --> Repo: OK
deactivate DB
Repo --> Service: OK
deactivate Repo

Service -> UI: PushSignalR("ItemServed")

Service --> Controller: Result(Success)
deactivate Service

Controller --> UI: 200 OK
deactivate Controller

UI --> Expediter: Hoàn thành ra món
end
deactivate UI

@enduml