@startuml SD_UC_A3_Manual_Refund_Approval
autonumber
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14

actor "Quản lý" as Manager
boundary "Giao diện Web" as UI
control "ManagerRefundController" as Controller
participant "RefundService" as Service
participant "ReservationRepository" as Repo
database "SQL Server" as DB
participant "VNPAY" as VNPAY

Manager -> UI: Chọn đơn, nhập lý do & Chấp thuận / Từ chối
activate UI

UI -> Controller: POST /api/manager/reservations/\n{id}/manual-refund
activate Controller

Controller -> Service: OverrideRefund(id, dto)
activate Service

Service -> Repo: GetReservation(id)
activate Repo
Repo -> DB: SELECT Reservation WHERE Id = id
activate DB
DB --> Repo: ReservationData
deactivate DB
Repo --> Service: Reservation
deactivate Repo

Service -> Service: Validate(Reservation)

alt Quản lý từ chối (UC-A3, 3a)
    Service -> Repo: UpdateStatus('RefundRejected') & InsertAuditLog
    activate Repo
    Repo -> DB: UPDATE Reservations\n& INSERT AuditLogs
    activate DB
    DB --> Repo: OK
    deactivate DB
    Repo --> Service: Saved
    deactivate Repo
    Service -> Service: NotifyGuest(Bác bỏ hoàn cọc)
else Quản lý chấp thuận
Service -> VNPAY: CallRefundApi(txnRef, amount)
activate VNPAY
VNPAY --> Service: RefundSuccess (00)
deactivate VNPAY

Service -> Repo: UpdateRefundStatus \n& InsertAuditLog
activate Repo
Repo -> DB: UPDATE Reservations \n& INSERT AuditLogs
activate DB
DB --> Repo: OK
deactivate DB
Repo --> Service: Saved
deactivate Repo
Service -> Service: NotifyGuest(Đã hoàn cọc)
end

Service --> Controller: Result(Success)
deactivate Service

Controller --> UI: 200 OK
deactivate Controller

UI --> Manager: Cập nhật trạng thái 
deactivate UI

@enduml