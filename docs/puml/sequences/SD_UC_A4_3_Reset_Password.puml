@startuml SD_UC_A4_3_Reset_Password
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14

actor "Quản trị viên" as Admin
boundary "Giao diện Web" as UI
control "AdminStaffController" as Controller
participant "StaffService" as Service
participant "StaffRepository" as Repo
database "SQL Server" as DB
participant "Email Service" as MailService

Admin -> UI: Bấm Đặt lại mật khẩu
activate UI

UI -> Controller: POST /api/admin/staff\n/{id}/reset-password
activate Controller

Controller -> Service: ResetPassword(id)
activate Service

Service -> Service: Generate & HashNewPassword

Service -> Repo: UpdatePasswordHash(id, hash)
activate Repo
Repo -> DB: UPDATE Users \nSET PasswordHash = ...
activate DB
DB --> Repo: OK
deactivate DB
Repo --> Service: OK
deactivate Repo

Service -> MailService: SendNewPassword(Email)
activate MailService
MailService --> Service: Sent
deactivate MailService

Service --> Controller: Result(Success)
deactivate Service

Controller --> UI: 200 OK
deactivate Controller

UI --> Admin: Đặt lại thành công
deactivate UI

@enduml
