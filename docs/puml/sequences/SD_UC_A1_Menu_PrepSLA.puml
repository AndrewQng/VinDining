@startuml SD_UC_A1_Menu_PrepSLA
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14

actor "Quản lý" as Manager
boundary "Giao diện Web" as UI
control "AdminMenuController" as Controller
participant "MenuService" as Service
participant "MenuRepository" as Repo
database "SQL Server" as DB

== Kịch bản 1: Thêm mới món ==

Manager -> UI: Nhập thông tin & Lưu
activate UI

UI -> Controller: POST /api/admin/menu-items
activate Controller

Controller -> Service: Create(dto)
activate Service

Service -> Service: Validate(dto)

Service -> Repo: Insert(item)
activate Repo

Repo -> DB: INSERT MenuItems
activate DB
DB --> Repo: OK (Id)
deactivate DB

Repo --> Service: item
deactivate Repo

Service --> Controller: dto
deactivate Service

Controller --> UI: 201 Created
deactivate Controller

UI --> Manager: Báo thành công
deactivate UI

== Kịch bản 2: Bật / Tắt trạng thái phục vụ ==

Manager -> UI: Đổi trạng thái
activate UI

UI -> Controller: PATCH /api/admin/menu-items/{id}/availability
activate Controller

Controller -> Service: UpdateAvailability(id, status)
activate Service

Service -> Repo: UpdateStatus(id, status)
activate Repo

Repo -> DB: UPDATE MenuItems
activate DB
DB --> Repo: OK
deactivate DB

Repo --> Service: OK
deactivate Repo

Service --> Controller: OK
deactivate Service

Controller --> UI: 200 OK
deactivate Controller

UI --> Manager: Cập nhật giao diện
deactivate UI

== Kịch bản 3: Thiết lập Set Menu ==

Manager -> UI: Nhập thông tin Set
activate UI

UI -> Controller: POST /api/admin/tasting-menus
activate Controller

Controller -> Service: CreateTastingMenu(dto)
activate Service

Service -> Service: ValidateItems(dto.Items)
Service -> Repo: InsertTastingMenu(menu, items)
activate Repo

Repo -> DB: INSERT TastingMenus \n& TastingMenuItems
activate DB
DB --> Repo: OK (Id)
deactivate DB

Repo --> Service: OK
deactivate Repo

Service --> Controller: Result.Success(dto)
deactivate Service

Controller --> UI: 201 Created
deactivate Controller

UI --> Manager: Cập nhật danh sách Set Menu
deactivate UI


@enduml