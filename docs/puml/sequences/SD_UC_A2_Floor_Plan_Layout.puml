@startuml SD_UC_A2_Floor_Plan_Layout
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14

actor "Quản lý" as Manager
boundary "Giao diện Web" as UI
control "AdminTableController" as Controller
participant "TableService" as Service
participant "TableRepository" as Repo
database "SQL Server" as DB

Manager -> UI: Chỉnh sửa & bấm Lưu sơ đồ
activate UI

UI -> Controller: PUT /api/admin/tables/layout
activate Controller

Controller -> Service: UpdateFloorPlan(dto)
activate Service

Service -> Repo: CheckActiveTables(tableIds)
activate Repo
Repo -> DB: SELECT Active/Reserved Tables
activate DB
DB --> Repo: Empty (Hợp lệ)
deactivate DB
Repo --> Service: OK
deactivate Repo

Service -> Repo: SaveCoordinatesAndZones(dto)
activate Repo

Repo -> DB: UPDATE TableCoordinates, Zones, Capacities
activate DB
DB --> Repo: OK
deactivate DB

Repo --> Service: Saved
deactivate Repo

Service -> UI: PushSignalR("FloorPlanUpdated")

Service --> Controller: Result(Success)
deactivate Service

Controller --> UI: 200 OK
deactivate Controller

UI --> Manager: Lưu sơ đồ thành công
deactivate UI
@enduml