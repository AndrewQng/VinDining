@startuml SD_UC_E5_Staff_Authentication
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 15

actor "Nhân viên" as Staff
boundary "Giao diện Web" as UI
control "AuthController" as Controller
participant "AuthService" as Service
participant "UserRepository" as Repo
database "SQL Server" as DB

Staff -> UI: Nhập tài khoản & Đăng nhập
activate UI
UI -> Controller: POST /api/auth/login (dto)
activate Controller
Controller -> Service: Authenticate(dto)
activate Service

Service -> Repo: FindByUsername(dto.Username)
activate Repo
Repo -> DB: SELECT * FROM Users WHERE Username = @user
activate DB
DB --> Repo: UserData
deactivate DB
Repo --> Service: user
deactivate Repo

Service -> Service: VerifyPassword(dto.Password, user.PasswordHash)

alt Mật khẩu đúng & Tài khoản không bị khóa
    Service -> Service: GenerateJwt(user)
    Service --> Controller: Result.Success(Token, Roles)
    Controller --> UI: 200 OK
    UI --> Staff: Đăng nhập thành công
else Sai mật khẩu >= 5 lần
    Service -> Repo: LockAccount(user.Id)
    activate Repo
    Repo -> DB: UPDATE Users SET LockoutEnd = DATEADD(mi, 15, NOW())
    activate DB
    DB --> Repo: OK
    deactivate DB
    Repo --> Service: Locked
    deactivate Repo
    Service --> Controller: Result.Fail("Locked")
    Controller --> UI: 423 Locked
    UI --> Staff: Tài khoản tạm khóa 15 phút
else Sai mật khẩu < 5 lần
    Service -> Repo: IncrementFailedCount(user.Id)
    activate Repo
    Repo -> DB: UPDATE Users SET FailedCount = FailedCount + 1
    activate DB
    DB --> Repo: OK
    deactivate DB
    Repo --> Service: Updated
    deactivate Repo
    Service --> Controller: Result.Fail("Invalid")
    Controller --> UI: 401 Unauthorized
    UI --> Staff: Sai tài khoản hoặc mật khẩu
end

deactivate Service
deactivate Controller
deactivate UI
@enduml